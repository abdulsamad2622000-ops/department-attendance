<UserControl x:Class="HobbiesClub.App.Views.MemberClubsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HobbiesClub.App.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <Style x:Key="ClubCard" TargetType="Button">
            <Setter Property="Width" Value="340" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="20" Padding="24,20">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="JoinCard" TargetType="Button">
            <Setter Property="Width" Value="340" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="Dash" Stroke="#94A3B8" StrokeThickness="1.5" StrokeDashArray="5 4"
                                       Fill="#F8FAFC" RadiusX="20" RadiusY="20" />
                            <ContentPresenter Margin="24,20" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dash" Property="Stroke" Value="#2563EB" />
                                <Setter TargetName="Dash" Property="Fill" Value="#F8FAFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Member header -->
        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Content="Done" Command="{Binding DoneCommand}" Style="{StaticResource PrimaryButton}"
                    Height="48" Width="140" FontSize="16" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
                <Grid Width="72" Height="72">
                    <Ellipse Fill="#DBE6FF" />
                    <Ellipse Visibility="{Binding HasPhoto, Converter={StaticResource B2V}}">
                        <Ellipse.Fill><ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill" /></Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding Initial}" Foreground="{StaticResource PrimaryBrush}" FontSize="30" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FullName}" FontSize="26" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border CornerRadius="999" Padding="10,3" Background="{Binding BadgeBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BadgeText}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                        <TextBlock Text="{Binding MemberCode}" Foreground="{StaticResource MutedTextBrush}" FontSize="15"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,0">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Your clubs" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,6" />
                <ItemsControl ItemsSource="{Binding Cards}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ClubCard}"
                                    Command="{Binding DataContext.OpenClubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,12" />
                                    <TextBlock Text="{Binding MonthText}" FontSize="15" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding LastText}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,14" />
                                    <TextBlock Text="Tap for details  →" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding HasJoinCards, Converter={StaticResource B2V}}" Margin="0,20,0,0">
                    <TextBlock Text="Other clubs" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding JoinCards}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource JoinCard}"
                                        Command="{Binding DataContext.JoinClubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="Bold" Foreground="#475569" />
                                        <TextBlock Text="You are not a member yet" FontSize="15" Foreground="#64748B" Margin="0,6,0,14" />
                                        <TextBlock Text="+ Join this club" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="{Binding Message}" helpers:AutoHide.Seconds="6" Foreground="{StaticResource DangerBrush}" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
