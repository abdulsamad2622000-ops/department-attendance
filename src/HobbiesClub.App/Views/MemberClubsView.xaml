<UserControl xmlns:helpers="clr-namespace:HobbiesClub.App.Helpers" x:Class="HobbiesClub.App.Views.MemberClubsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </UserControl.Resources>
    <Grid Margin="20">
        <Button Content="Done" Command="{Binding DoneCommand}" FontSize="18" Padding="20,8"
                HorizontalAlignment="Right" VerticalAlignment="Top" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,50,0,0">
            <StackPanel HorizontalAlignment="Center">
                <Grid Width="90" Height="90" HorizontalAlignment="Center">
                    <Ellipse Fill="#FF3B5BA9" />
                <Ellipse Visibility="{Binding HasPhoto, Converter={StaticResource B2V}}"><Ellipse.Fill><ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse>
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="42" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding FullName}" FontSize="28" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,10,0,4" />
                <Border CornerRadius="12" Padding="14,3" HorizontalAlignment="Center" Background="{Binding BadgeBrush}">
                    <TextBlock Text="{Binding BadgeText}" Foreground="White" FontWeight="Bold" FontSize="15" />
                </Border>
                <TextBlock Text="{Binding MemberCode}" Foreground="Gray" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,6,0,24" />

                <TextBlock Text="Your clubs" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Cards}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="300" Margin="12" Padding="18" HorizontalContentAlignment="Left"
                                    Background="White" BorderBrush="#FF3B5BA9" BorderThickness="2"
                                    Command="{Binding DataContext.OpenClubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="Bold" />
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                               FontSize="16" FontWeight="Bold" Margin="0,6,0,10" />
                                    <TextBlock Text="{Binding MonthText}" FontSize="16" />
                                    <TextBlock Text="{Binding LastText}" FontSize="14" Foreground="Gray" Margin="0,2,0,12" />
                                    <TextBlock Text="Tap for details" FontSize="14" Foreground="#FF3B5BA9" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding HasJoinCards, Converter={StaticResource B2V}}" Margin="0,16,0,0">
                    <TextBlock Text="Other clubs" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding JoinCards}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="300" Margin="12" Padding="0" Background="Transparent" BorderThickness="0"
                                        Command="{Binding DataContext.JoinClubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Rectangle Stroke="#FF3B5BA9" StrokeThickness="2" StrokeDashArray="4 3"
                                                   Fill="#FFF4F6FB" RadiusX="2" RadiusY="2" />
                                        <StackPanel Margin="18">
                                            <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="Bold" Foreground="Gray" />
                                            <TextBlock Text="You are not a member yet" FontSize="15" Foreground="Gray" Margin="0,6,0,12" />
                                            <TextBlock Text="+ Join this club" FontSize="16" Foreground="#FF3B5BA9" FontWeight="Bold" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="{Binding Message}" helpers:AutoHide.Seconds="6" Foreground="Firebrick" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>


