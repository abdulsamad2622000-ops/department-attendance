<Window x:Class="HobbiesClub.App.Views.VerifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verified" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24"><StackPanel.Resources><BooleanToVisibilityConverter x:Key="B2V" /></StackPanel.Resources>
        <Grid Width="110" Height="110" HorizontalAlignment="Center">
            <Ellipse Fill="#FF3B5BA9" />
                <Ellipse Visibility="{Binding HasPhoto, Converter={StaticResource B2V}}"><Ellipse.Fill><ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse>
            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="52" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding FullName}" FontSize="26" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,12,0,4" TextWrapping="Wrap" TextAlignment="Center" />
        <Border CornerRadius="12" Padding="14,3" HorizontalAlignment="Center" Background="{Binding BadgeBrush}">
            <TextBlock Text="{Binding BadgeText}" Foreground="White" FontWeight="Bold" FontSize="15" />
        </Border>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Member ID" Foreground="Gray" Margin="0,3" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MemberCode}" Margin="0,3" />
            <TextBlock Grid.Row="1" Text="Rank" Foreground="Gray" Margin="0,3" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Rank}" Margin="0,3" />
            <TextBlock Grid.Row="2" Text="R/N" Foreground="Gray" Margin="0,3" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RollRegNo}" Margin="0,3" />
            <TextBlock Grid.Row="3" Text="Unit" Foreground="Gray" Margin="0,3" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Unit}" Margin="0,3" />
            <TextBlock Grid.Row="4" Text="Phone" Foreground="Gray" Margin="0,3" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Phone}" Margin="0,3" />
            <TextBlock Grid.Row="5" Text="Clubs" Foreground="Gray" Margin="0,3" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Clubs}" Margin="0,3" TextWrapping="Wrap" />
        </Grid>

        <Border BorderBrush="LightGray" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
            <StackPanel>
                <StackPanel Visibility="{Binding HasPrevious, Converter={StaticResource B2V}}">
                    <TextBlock Text="Previous entry" Foreground="Gray" HorizontalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0" FontSize="16">
                        <Run Text="{Binding PreviousText, Mode=OneWay}" />
                        <Run Text=" - " />
                        <Run Text="{Binding PreviousType, Mode=OneWay}" FontWeight="Bold" Foreground="{Binding PreviousBrush}" />
                    </TextBlock>
                    <TextBlock Text="{Binding PreviousMethodText}" Foreground="Gray" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,10" />
                </StackPanel>
                <TextBlock Text="{Binding ClubName}" Foreground="{Binding CurrentBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Text="{Binding CurrentText}" Foreground="{Binding CurrentBrush}" FontSize="34"
                           FontWeight="ExtraBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CurrentTime}" Foreground="{Binding CurrentBrush}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" />
                <TextBlock Text="{Binding MethodText}" Foreground="Gray" FontSize="16" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Text="{Binding AutoNote}" Foreground="DarkOrange" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasAutoNote, Converter={StaticResource B2V}}" />
            </StackPanel>
        </Border>

        <Button Content="OK" IsDefault="True" Click="OnOk" FontSize="20" Padding="30,8"
                HorizontalAlignment="Center" Margin="0,16,0,0" />
    </StackPanel>
</Window>







