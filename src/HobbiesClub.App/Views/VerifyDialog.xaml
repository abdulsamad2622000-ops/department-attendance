<Window x:Class="HobbiesClub.App.Views.VerifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verified" Width="608" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#F5F7FB" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="5" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Border Margin="24" Background="White" CornerRadius="24" Padding="36,32">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.18" Color="#0F172A" />
        </Border.Effect>
        <StackPanel>
            <Grid Width="120" Height="120" HorizontalAlignment="Center">
                <Ellipse Fill="#CBD5E1" />
                <Ellipse Visibility="{Binding HasPhoto, Converter={StaticResource B2V}}">
                    <Ellipse.Fill><ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill" /></Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{Binding Initial}" Foreground="#334155" FontSize="44" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="{Binding FullName}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,8" />
            <Border CornerRadius="999" Padding="12,4" HorizontalAlignment="Center" Background="{Binding BadgeBrush}">
                <TextBlock Text="{Binding BadgeText}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
            </Border>

            <UniformGrid Columns="2" Margin="-5,18,-5,0">
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="Member ID" Style="{StaticResource TileLabel}" /><TextBlock Text="{Binding MemberCode}" Style="{StaticResource TileValue}" /></StackPanel></Border>
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="Rank" Style="{StaticResource TileLabel}" /><TextBlock Text="{Binding Rank}" Style="{StaticResource TileValue}" /></StackPanel></Border>
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="R/N" Style="{StaticResource TileLabel}" /><TextBlock Text="{Binding RollRegNo}" Style="{StaticResource TileValue}" /></StackPanel></Border>
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="Unit" Style="{StaticResource TileLabel}" /><TextBlock Text="{Binding Unit}" Style="{StaticResource TileValue}" /></StackPanel></Border>
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="Phone" Style="{StaticResource TileLabel}" /><TextBlock Text="{Binding Phone}" Style="{StaticResource TileValue}" /></StackPanel></Border>
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="Clubs" Style="{StaticResource TileLabel}" /><TextBlock Text="{Binding Clubs}" Style="{StaticResource TileValue}" /></StackPanel></Border>
            </UniformGrid>

            <StackPanel Visibility="{Binding HasPrevious, Converter={StaticResource B2V}}" Margin="0,14,0,0">
                <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MutedTextBrush}">
                    <Run Text="Previous: " /><Run Text="{Binding PreviousText, Mode=OneWay}" /><Run Text=" - " /><Run Text="{Binding PreviousType, Mode=OneWay}" FontWeight="Bold" Foreground="{Binding PreviousBrush}" />
                </TextBlock>
                <TextBlock Text="{Binding PreviousMethodText}" HorizontalAlignment="Center" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
            </StackPanel>

            <Border CornerRadius="16" Padding="18" Margin="0,14,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentText}" Value="CHECKED OUT">
                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding ClubName}" Foreground="{Binding CurrentBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentText}" Foreground="{Binding CurrentBrush}" FontSize="36" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentTime}" Foreground="{Binding CurrentBrush}" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding MethodText}" Foreground="{Binding CurrentBrush}" Opacity="0.8" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding AutoNote}" Foreground="#B45309" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"
                       Visibility="{Binding HasAutoNote, Converter={StaticResource B2V}}" />

            <Button Content="OK" IsDefault="True" Click="OnOk" Style="{StaticResource PrimaryButton}"
                    FontSize="16" Width="200" Height="52" HorizontalAlignment="Center" Margin="0,20,0,0" />
        </StackPanel>
    </Border>
</Window>
