<Window x:Class="HobbiesClub.App.Views.FingerScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fingerprint" Width="760" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Margin="20" CornerRadius="24" Padding="32,28" Background="{StaticResource NavyGradient}" BorderBrush="#1E4A80" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="#000000" /></Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Fingerprint" FontSize="24" FontWeight="Bold" Foreground="White" />
            <TextBlock x:Name="SubtitleText" Text="Finger 1 of 2" FontSize="15" Foreground="#C9A227" Margin="0,4,0,20" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Hand -->
                <Border Grid.Column="0" Background="#0E3263" CornerRadius="18" Padding="16" BorderBrush="#1E4A80" BorderThickness="1">
                    <StackPanel>
                        <Viewbox Height="230">
                            <Canvas Width="220" Height="240">
                                <Border x:Name="F_Little" Canvas.Left="44" Canvas.Top="72" Width="26" Height="62" CornerRadius="13" Background="#1E4A80" BorderBrush="#4A6FA5" BorderThickness="1.5" />
                                <Border x:Name="F_Ring" Canvas.Left="74" Canvas.Top="40" Width="29" Height="90" CornerRadius="14" Background="#1E4A80" BorderBrush="#4A6FA5" BorderThickness="1.5" />
                                <Border x:Name="F_Middle" Canvas.Left="107" Canvas.Top="22" Width="30" Height="106" CornerRadius="15" Background="#1E4A80" BorderBrush="#4A6FA5" BorderThickness="1.5" />
                                <Border x:Name="F_Index" Canvas.Left="141" Canvas.Top="40" Width="29" Height="90" CornerRadius="14" Background="#1E4A80" BorderBrush="#4A6FA5" BorderThickness="1.5" />
                                <Border x:Name="F_Thumb" Canvas.Left="168" Canvas.Top="118" Width="27" Height="66" CornerRadius="13" Background="#1E4A80" BorderBrush="#4A6FA5" BorderThickness="1.5">
                                    <Border.RenderTransform><RotateTransform Angle="-35" /></Border.RenderTransform>
                                </Border>
                                <Border Canvas.Left="40" Canvas.Top="112" Width="134" Height="116" CornerRadius="34" Background="#1E4A80" BorderBrush="#4A6FA5" BorderThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="HandHint" Text="Use the highlighted finger" Foreground="#C7D2E5" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Scanner -->
                <Border Grid.Column="2" Background="#061632" CornerRadius="18" Padding="16" BorderBrush="#1E4A80" BorderThickness="1">
                    <StackPanel>
                        <Grid Height="230" Width="180" HorizontalAlignment="Center" ClipToBounds="True">
                            <Border CornerRadius="16" Background="#0B2A55" BorderBrush="#4FA3E0" BorderThickness="1.5" />
                            <Viewbox x:Name="PrintIcon" Margin="24">
                                <Path Stroke="#4FA3E0" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M30,70 A30,40 0 0 1 90,70 M38,74 A22,30 0 0 1 82,74 M46,78 A14,20 0 0 1 74,78 M54,82 A6,10 0 0 1 66,82 M30,70 V96 M90,70 V100 M38,74 V106 M82,74 V108 M46,78 V112 M74,78 V114 M54,82 V114 M66,82 V116 M60,86 V118" />
                            </Viewbox>
                            <Image x:Name="PrintImage" Stretch="Uniform" Margin="8" Visibility="Collapsed" />
                            <Rectangle x:Name="ScanLine" Height="4" VerticalAlignment="Top" Margin="10,0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#00C9A227" Offset="0" />
                                        <GradientStop Color="#FFC9A227" Offset="0.5" />
                                        <GradientStop Color="#00C9A227" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform><TranslateTransform x:Name="ScanShift" /></Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Grid Margin="0,12,0,0" Height="8">
                            <Border CornerRadius="4" Background="#12386E" />
                            <Border x:Name="QualityBar" CornerRadius="4" Background="#22C55E" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <TextBlock x:Name="QualityText" Text="Quality —" Foreground="#9FB3D1" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="StatusText" Text="Place your finger on the scanner" FontSize="20" FontWeight="SemiBold" Foreground="White"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,18" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="RetryButton" Content="Retry" Width="150" Height="46" Margin="0,0,12,0" Visibility="Collapsed"
                        Style="{StaticResource PrimaryButton}" Background="#C9A227" BorderBrush="#C9A227" Foreground="#071A33" Click="OnRetry" />
                <Button x:Name="CancelButton" Content="Cancel" Width="150" Height="46" Background="Transparent" Foreground="White" BorderBrush="#2B5A94" Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
