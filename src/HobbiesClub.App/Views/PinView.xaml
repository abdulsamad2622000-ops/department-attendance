<UserControl x:Class="HobbiesClub.App.Views.PinView" Background="{StaticResource NavyGradient}" Foreground="White"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="clr-namespace:HobbiesClub.App.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <Style x:Key="Key" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="ClubChoice" TargetType="Button">
            <Setter Property="Width" Value="340" />
            <Setter Property="Height" Value="180" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0B2A55" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0B2A55" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#071A33" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image Grid.RowSpan="2" Margin="-40,-28" Source="{Binding KioskBackground, Source={x:Static helpers:BrandingSource.Instance}}" Stretch="Fill" Opacity="0.15" IsHitTestVisible="False" />
        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Command="{Binding BackCommand}" Height="42" Padding="16,0" VerticalAlignment="Center" Background="Transparent" Foreground="White" BorderBrush="#2B5A94">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M19,12 H5 M11,6 L5,12 L11,18" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Back" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal">
                <Border Width="60" Height="60" CornerRadius="30" Background="#071A33" BorderBrush="#C9A227" BorderThickness="2">
                    <Ellipse Margin="3"><Ellipse.Fill><ImageBrush ImageSource="{Binding LoginLogo, Source={x:Static helpers:BrandingSource.Instance}}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle, Source={x:Static helpers:BrandingSource.Instance}}" FontSize="22" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding HeaderSubtitle, Source={x:Static helpers:BrandingSource.Instance}}" FontSize="14" Foreground="#C7D2E5" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding Prompt}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="700" />

            <Border Background="White" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1"
                    CornerRadius="14" Width="372" Height="68" Margin="0,22,0,0"
                    Visibility="{Binding ShowKeypad, Converter={StaticResource B2V}}">
                <TextBlock Text="{Binding Display}" FontSize="34" FontWeight="Bold" Foreground="#0B2A55" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="{Binding Message}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="640" Margin="0,16,0,16">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#86EFAC" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="#FCA5A5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <UniformGrid Columns="3" Width="384" Visibility="{Binding ShowKeypad, Converter={StaticResource B2V}}">
                <Button Content="1" Command="{Binding DigitCommand}" CommandParameter="1" Style="{StaticResource Key}" />
                <Button Content="2" Command="{Binding DigitCommand}" CommandParameter="2" Style="{StaticResource Key}" />
                <Button Content="3" Command="{Binding DigitCommand}" CommandParameter="3" Style="{StaticResource Key}" />
                <Button Content="4" Command="{Binding DigitCommand}" CommandParameter="4" Style="{StaticResource Key}" />
                <Button Content="5" Command="{Binding DigitCommand}" CommandParameter="5" Style="{StaticResource Key}" />
                <Button Content="6" Command="{Binding DigitCommand}" CommandParameter="6" Style="{StaticResource Key}" />
                <Button Content="7" Command="{Binding DigitCommand}" CommandParameter="7" Style="{StaticResource Key}" />
                <Button Content="8" Command="{Binding DigitCommand}" CommandParameter="8" Style="{StaticResource Key}" />
                <Button Content="9" Command="{Binding DigitCommand}" CommandParameter="9" Style="{StaticResource Key}" />
                <Button Content="⌫" Command="{Binding BackspaceCommand}" Style="{StaticResource Key}" FontSize="26" Foreground="{StaticResource MutedTextBrush}" />
                <Button Content="0" Command="{Binding DigitCommand}" CommandParameter="0" Style="{StaticResource Key}" />
                <Button Content="OK" Command="{Binding OkCommand}" Style="{StaticResource PrimaryButton}" Background="#16A34A" BorderBrush="#16A34A" FontSize="22" Height="76" Margin="6" />
            </UniformGrid>

            <ItemsControl ItemsSource="{Binding Clubs}" Visibility="{Binding ShowClubs, Converter={StaticResource B2V}}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ClubChoice}"
                                Command="{Binding DataContext.SelectClubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Tap to continue" FontSize="15" Opacity="0.8" HorizontalAlignment="Center" Margin="0,8,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>











