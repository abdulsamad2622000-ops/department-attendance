<UserControl x:Class="HobbiesClub.App.Views.PinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </UserControl.Resources>
    <Grid Margin="20">
        <Button Content="Back" Command="{Binding BackCommand}" Padding="12,6"
                HorizontalAlignment="Left" VerticalAlignment="Top" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding Prompt}" FontSize="26" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <Border BorderBrush="Gray" BorderThickness="1" Width="300" Height="56" Margin="0,12,0,0"
                    Visibility="{Binding ShowKeypad, Converter={StaticResource B2V}}">
                <TextBlock Text="{Binding Display}" FontSize="30" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Message}" FontSize="20" HorizontalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="600" Margin="0,14,0,14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="SeaGreen" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="Firebrick" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <UniformGrid Columns="3" Width="330"
                         Visibility="{Binding ShowKeypad, Converter={StaticResource B2V}}">
                <Button Content="1" Command="{Binding DigitCommand}" CommandParameter="1" FontSize="26" Height="64" Margin="4" />
                <Button Content="2" Command="{Binding DigitCommand}" CommandParameter="2" FontSize="26" Height="64" Margin="4" />
                <Button Content="3" Command="{Binding DigitCommand}" CommandParameter="3" FontSize="26" Height="64" Margin="4" />
                <Button Content="4" Command="{Binding DigitCommand}" CommandParameter="4" FontSize="26" Height="64" Margin="4" />
                <Button Content="5" Command="{Binding DigitCommand}" CommandParameter="5" FontSize="26" Height="64" Margin="4" />
                <Button Content="6" Command="{Binding DigitCommand}" CommandParameter="6" FontSize="26" Height="64" Margin="4" />
                <Button Content="7" Command="{Binding DigitCommand}" CommandParameter="7" FontSize="26" Height="64" Margin="4" />
                <Button Content="8" Command="{Binding DigitCommand}" CommandParameter="8" FontSize="26" Height="64" Margin="4" />
                <Button Content="9" Command="{Binding DigitCommand}" CommandParameter="9" FontSize="26" Height="64" Margin="4" />
                <Button Content="Del" Command="{Binding BackspaceCommand}" FontSize="22" Height="64" Margin="4" />
                <Button Content="0" Command="{Binding DigitCommand}" CommandParameter="0" FontSize="26" Height="64" Margin="4" />
                <Button Content="OK" Command="{Binding OkCommand}" FontSize="22" Height="64" Margin="4" />
            </UniformGrid>
            <ItemsControl ItemsSource="{Binding Clubs}"
                          Visibility="{Binding ShowClubs, Converter={StaticResource B2V}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Name}" FontSize="24" Width="320" Height="70" Margin="6"
                                Command="{Binding DataContext.SelectClubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
