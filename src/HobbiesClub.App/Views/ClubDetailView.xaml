<UserControl x:Class="HobbiesClub.App.Views.ClubDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="LightGray" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <Button Content="Back" Command="{Binding BackCommand}" FontSize="18" Padding="20,8"
                HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Button Content="Done" Command="{Binding DoneCommand}" FontSize="18" Padding="20,8"
                HorizontalAlignment="Right" VerticalAlignment="Top" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,50,0,0">
            <StackPanel Width="720" HorizontalAlignment="Center">
                <TextBlock Text="{Binding ClubName}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,4">
                    <TextBlock Text="{Binding FullName}" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border CornerRadius="12" Padding="12,2" Background="{Binding BadgeBrush}">
                        <TextBlock Text="{Binding BadgeText}" Foreground="White" FontWeight="Bold" FontSize="14" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="18"
                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,16" />

                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Tile}"><StackPanel>
                        <TextBlock Text="Visits this month" Foreground="Gray" />
                        <TextBlock Text="{Binding MonthVisits}" FontSize="26" FontWeight="Bold" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource Tile}"><StackPanel>
                        <TextBlock Text="Time this month" Foreground="Gray" />
                        <TextBlock Text="{Binding MonthTime}" FontSize="26" FontWeight="Bold" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource Tile}"><StackPanel>
                        <TextBlock Text="Average per visit" Foreground="Gray" />
                        <TextBlock Text="{Binding AverageTime}" FontSize="26" FontWeight="Bold" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource Tile}"><StackPanel>
                        <TextBlock Text="Total visits" Foreground="Gray" />
                        <TextBlock Text="{Binding TotalVisits}" FontSize="26" FontWeight="Bold" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource Tile}"><StackPanel>
                        <TextBlock Text="Total time" Foreground="Gray" />
                        <TextBlock Text="{Binding TotalTime}" FontSize="26" FontWeight="Bold" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource Tile}"><StackPanel>
                        <TextBlock Text="Last entry" Foreground="Gray" />
                        <TextBlock Text="{Binding LastEntry}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                    </StackPanel></Border>
                </UniformGrid>

                <TextBlock Text="Recent entries" FontSize="20" FontWeight="SemiBold" Margin="8,18,0,6" />
                <TextBlock Text="No entries yet." Foreground="Gray" Margin="8,0,0,0"
                           Visibility="{Binding HasNoEntries, Converter={StaticResource B2V}}" />
                <ItemsControl ItemsSource="{Binding Recent}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#FFEEEEEE" BorderThickness="0,0,0,1" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding When}" FontSize="15" />
                                    <TextBlock Grid.Column="1" Text="{Binding TypeText}" Foreground="{Binding TypeBrush}"
                                               FontWeight="Bold" FontSize="15" />
                                    <TextBlock Grid.Column="2" Text="{Binding Extra}" Foreground="Gray" FontSize="14" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

