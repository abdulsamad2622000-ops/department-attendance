<UserControl xmlns:helpers="clr-namespace:HobbiesClub.App.Helpers" x:Class="HobbiesClub.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{Binding StatusBrush}" BorderThickness="2" Padding="14,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding FolderText}" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ExternalText}" Foreground="{Binding ExternalBrush}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="Backup now" Command="{Binding BackupNowCommand}" IsEnabled="{Binding IsIdle}" Padding="14,6" Margin="0,0,8,6" FontWeight="SemiBold" />
            <Button Content="Copy to USB / folder" Command="{Binding CopyToFolderCommand}" Padding="14,6" Margin="0,0,8,6" />
            <Button Content="Open backups folder" Command="{Binding OpenFolderCommand}" Padding="14,6" Margin="0,0,24,6" />
            <Button Content="Choose safe copy folder..." Command="{Binding ChooseExternalFolderCommand}" Padding="14,6" Margin="0,0,8,6" />
            <Button Content="Remove safe copy folder" Command="{Binding ClearExternalFolderCommand}" Padding="14,6" Margin="0,0,24,6" />
            <Button Content="Restore selected" Command="{Binding RestoreSelectedCommand}" IsEnabled="{Binding IsIdle}" Padding="14,6" Margin="0,0,8,6" Foreground="Firebrick" />
            <Button Content="Restore from file..." Command="{Binding RestoreFromFileCommand}" IsEnabled="{Binding IsIdle}" Padding="14,6" Margin="0,0,8,6" Foreground="Firebrick" />
            <Button Content="Refresh" Command="{Binding LoadCommand}" Padding="14,6" Margin="0,0,8,6" />
        </WrapPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" helpers:AutoHide.Seconds="6" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" helpers:AutoHide.Seconds="6" Foreground="SeaGreen" TextWrapping="Wrap" Margin="0,0,0,6" />

        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single" GridLinesVisibility="Horizontal" RowHeight="30">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="200" />
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="180" />
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="260" />
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

