<UserControl x:Class="HobbiesClub.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HobbiesClub.App.Helpers">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Backup" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Daily automatic backups, kept for 30 days" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Status cards -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" CornerRadius="16" Padding="22,18" BorderBrush="{Binding StatusBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Backup now" Command="{Binding BackupNowCommand}" IsEnabled="{Binding IsIdle}"
                                Style="{StaticResource PrimaryButton}" Height="42" Padding="20,0" />
                        <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Height="42" Padding="18,0" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Last backup" FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding FolderText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" CornerRadius="16" Padding="22,18" BorderBrush="{Binding ExternalBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Choose folder" Command="{Binding ChooseExternalFolderCommand}" Height="42" Padding="18,0" />
                        <Button Content="Remove" Command="{Binding ClearExternalFolderCommand}" Height="42" Padding="18,0" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Safe copy folder (USB / cloud)" FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding ExternalText}" Foreground="{Binding ExternalBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Actions -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Restore selected" Command="{Binding RestoreSelectedCommand}" IsEnabled="{Binding IsIdle}"
                        Style="{StaticResource DangerButton}" Height="42" Padding="18,0" />
                <Button Content="Restore from file..." Command="{Binding RestoreFromFileCommand}" IsEnabled="{Binding IsIdle}"
                        Style="{StaticResource DangerButton}" Height="42" Padding="18,0" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Copy to USB / folder" Command="{Binding CopyToFolderCommand}" Height="42" Padding="18,0" />
                <Button Content="Refresh" Command="{Binding LoadCommand}" Height="42" Padding="18,0" Margin="10,0,0,0" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" helpers:AutoHide.Seconds="6" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="4,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" helpers:AutoHide.Seconds="6" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="4,0,0,8" />

        <!-- History -->
        <Border Style="{StaticResource Card}" CornerRadius="16" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Backup history" FontSize="17" FontWeight="Bold" Margin="20,16,20,10" />
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single" RowHeight="44" BorderThickness="0" Margin="0,0,0,6">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="220">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="190" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="260">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="OK">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
