<UserControl xmlns:helpers="clr-namespace:HobbiesClub.App.Helpers" x:Class="HobbiesClub.App.Views.AdminShellView" Background="{StaticResource NavyGradient}" Foreground="White"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HobbiesClub.App.Views"
             xmlns:app="clr-namespace:HobbiesClub.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="UB2V" />

        <!-- Sidebar menu item -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#C7D2E5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" CornerRadius="10" Padding="14,11" Margin="0,0,0,4">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12386E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A4A85" /><Setter TargetName="Bd" Property="BorderBrush" Value="#C9A227" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <TabControl FontSize="14" Background="Transparent" BorderThickness="0" Padding="0">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="248" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0B2A55" BorderThickness="0" Padding="16,24" TextElement.Foreground="White">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,0">
                                <Button Content="Log out" Command="{Binding LogoutCommand}" Height="44" Background="Transparent" Foreground="White" BorderBrush="#2B5A94" />
                                <TextBlock Text="{x:Static app:AppInfo.VersionText}" FontSize="11" Foreground="#9FB3D1" Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,20">
                                    <Border Width="44" Height="44" CornerRadius="22" Background="#071A33" BorderBrush="#C9A227" BorderThickness="2"><Ellipse Margin="3"><Ellipse.Fill><ImageBrush ImageSource="/Assets/navy-logo.png" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse></Border>
                                    <TextBlock FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0">Fleet UMS Hobby Club<LineBreak />&amp; AI Center</TextBlock>
                                </StackPanel>

                                <Border Background="#0E3263" BorderBrush="#1E4A80" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#D3DEEF">
                                            <TextBlock Text="{Binding DisplayInitial}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                            <TextBlock Text="Super Admin" FontSize="12" Foreground="#C9A227" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel IsItemsHost="True" />
                        </DockPanel>
                    </Border>

                    <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" Margin="32,28" TextElement.Foreground="White" TextElement.FontWeight="Normal" />
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <TabItem Header="Dashboard">
            <views:DashboardView DataContext="{Binding Dashboard}" />
        </TabItem>

        <TabItem Header="Members">
            <views:MembersView DataContext="{Binding Members}" />
        </TabItem>

        <TabItem Header="Reports">
            <views:ReportsView DataContext="{Binding Reports}" />
        </TabItem>

        <TabItem Header="Users">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Users" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Staff accounts that can sign in" Foreground="#9FB3D1" Margin="0,4,0,0" />
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- Create user -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" CornerRadius="16" Padding="22,20" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Create user" FontSize="18" FontWeight="Bold" Margin="0,0,0,14" />
                            <TextBlock Text="Full name" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" Height="42" Margin="0,0,0,12" />
                            <TextBlock Text="Username" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Height="42" Margin="0,0,0,12" />
                            <TextBlock Text="Password (at least 8 characters)" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                            <views:PasswordField Password="{Binding NewPassword, Mode=TwoWay}" Margin="0,0,0,12" />
                            <TextBlock Text="Role" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" Height="42" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding Error}" helpers:AutoHide.Seconds="6" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Message}" helpers:AutoHide.Seconds="6" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <Button Content="Create user" Command="{Binding CreateUserCommand}" Style="{StaticResource PrimaryButton}" Height="44" />
                        </StackPanel>
                    </Border>

                    <!-- List + edit -->
                    <DockPanel Grid.Column="0">
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" CornerRadius="16" Padding="22,18" Margin="0,14,0,0"
                                Visibility="{Binding HasSelectedUser, Converter={StaticResource UB2V}}">
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="Bold"><Run Text="Edit user: " /><Run Text="{Binding SelectedUser.Username, Mode=OneWay}" /></TextBlock>
                                <WrapPanel Margin="0,12,0,0">
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="Full name" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding EditUserFullName, UpdateSourceTrigger=PropertyChanged}" Width="240" Height="42" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="Role" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding EditUserRole}" Width="160" Height="42" VerticalContentAlignment="Center" Padding="10,0" />
                                    </StackPanel>
                                    <CheckBox Content="Active (can log in)" IsChecked="{Binding EditUserActive}" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                                </WrapPanel>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Save changes" Command="{Binding SaveUserCommand}" Style="{StaticResource PrimaryButton}" Height="42" Padding="18,0" Margin="0,0,10,0" />
                                    <Button Content="Reset password" Command="{Binding ResetUserPasswordCommand}" Height="42" Padding="18,0" Margin="0,0,10,0" />
                                    <Button Content="Unlock account" Command="{Binding UnlockUserCommand}" Height="42" Padding="18,0" />
                                </WrapPanel>
                                <TextBlock Text="{Binding UserError}" helpers:AutoHide.Seconds="6" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding UserMessage}" helpers:AutoHide.Seconds="6" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" CornerRadius="16" Padding="0">
                            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" CanUserAddRows="False" RowHeight="48" BorderThickness="0" Margin="0,6,0,6">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="160">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
                                    <DataGridTemplateColumn Header="Role" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#D3DEEF" CornerRadius="999" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Role}" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Status" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="999" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Active}" Value="Yes">
                                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Inactive" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Active}" Value="Yes">
                                                                        <Setter Property="Text" Value="Active" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </TabItem>

        <TabItem Header="Activity log">
            <views:ActivityLogView DataContext="{Binding ActivityLog}" />
        </TabItem>

        <TabItem Header="Backup">
            <views:BackupView DataContext="{Binding Backup}" />
        </TabItem>
        <TabItem Header="Settings">
            <views:SettingsView />
        </TabItem>
    </TabControl>
</UserControl>










