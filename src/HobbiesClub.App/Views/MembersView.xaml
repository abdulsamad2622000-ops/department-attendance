<UserControl x:Class="HobbiesClub.App.Views.MembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="4"
                     ToolTip="Name, phone or Member ID" />
            <ComboBox ItemsSource="{Binding ClubOptions}" SelectedItem="{Binding ClubFilter}" Width="150"
                      Margin="12,0,0,0" Padding="4" />
            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" Width="120"
                      Margin="8,0,0,0" Padding="4" />
            <Button Content="Refresh" Command="{Binding LoadCommand}" Padding="10,4" Margin="12,0,0,0" />
            <TextBlock Text="{Binding Summary}" Foreground="Gray" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PanelCol" Width="280" MinWidth="240" MaxWidth="500" />
            </Grid.ColumnDefinitions>
        <Border Grid.Column="2" Margin="0" Padding="12" BorderBrush="LightGray"
                BorderThickness="1" Visibility="{Binding HasSelection, Converter={StaticResource B2V}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,14,0">
                    <Grid Width="120" Height="120" HorizontalAlignment="Center">
                        <Ellipse Fill="#FF3B5BA9" />
                        <TextBlock Text="{Binding Selected.Initial}" Foreground="White" FontWeight="Bold" FontSize="48"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Selected.Photo}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="{Binding Selected.FullName}" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock HorizontalAlignment="Center" Foreground="Gray">
                        <Run Text="ID " /><Run Text="{Binding Selected.MemberCode, Mode=OneWay}" />
                        <Run Text=" - " /><Run Text="{Binding Selected.Status, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Text="{Binding ActionError}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding ActionMessage}" Foreground="SeaGreen" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="Details" Margin="0,14,0,2" FontWeight="SemiBold" />
                    <TextBlock Text="Name" Foreground="Gray" FontSize="11" />
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,4" />
                    <TextBlock Text="Phone" Foreground="Gray" FontSize="11" />
                    <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,4" />
                    <TextBlock Text="Rank" Foreground="Gray" FontSize="11" />
                    <TextBox Text="{Binding EditRank, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,4" />
                    <TextBlock Text="R/N" Foreground="Gray" FontSize="11" />
                    <TextBox Text="{Binding EditRoll, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,4" />
                    <TextBlock Text="Unit" Foreground="Gray" FontSize="11" />
                    <TextBox Text="{Binding EditUnit, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,4" />
                    <Button Content="Save details" Command="{Binding SaveDetailsCommand}" Padding="8" Margin="0,4,0,0" />

                    <StackPanel Visibility="{Binding IsActiveMember, Converter={StaticResource B2V}}">
                        <Button Content="Re-enroll face" Command="{Binding ReenrollFaceCommand}" Padding="8" Margin="0,12,0,0" />
                        <Button Content="Re-enroll fingerprints" Command="{Binding ReenrollFingersCommand}" Padding="8" Margin="0,8,0,0" />
                        <Button Content="Reset PIN" Command="{Binding ResetPinCommand}" Padding="8" Margin="0,8,0,0" />

                        <TextBlock Text="Badge" Margin="0,14,0,2" FontWeight="SemiBold" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveBadgeCommand}" Padding="10,4" Margin="6,0,0,0" />
                            <ComboBox ItemsSource="{Binding BadgeOptions}" SelectedItem="{Binding SelectedBadge}" Padding="4" />
                        </DockPanel>

                        <TextBlock Text="Clubs" Margin="0,14,0,2" FontWeight="SemiBold" />
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding RemoveClubCommand}" Padding="10,4" Margin="6,0,0,0" />
                            <ComboBox ItemsSource="{Binding MyClubs}" SelectedItem="{Binding SelectedMyClub}"
                                      DisplayMemberPath="Name" Padding="4" />
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddClubCommand}" Padding="10,4" Margin="6,0,0,0" />
                            <ComboBox ItemsSource="{Binding JoinableClubs}" SelectedItem="{Binding SelectedJoinClub}"
                                      DisplayMemberPath="Name" Padding="4" />
                        </DockPanel>

                        <Button Content="Terminate member" Command="{Binding TerminateCommand}" Padding="8" Margin="0,18,0,0"
                                Foreground="Firebrick" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsTerminated, Converter={StaticResource B2V}}">
                        <Button Content="Reactivate member" Command="{Binding ReactivateCommand}" Padding="8" Margin="0,18,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="LightGray" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                      Cursor="SizeWE" Visibility="{Binding HasSelection, Converter={StaticResource B2V}}" />

        <DataGrid Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                  RowHeight="46" GridLinesVisibility="Horizontal" MinWidth="420" HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Width="38" Height="38">
                                <Ellipse Fill="#FF3B5BA9" />
                                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="ID" Binding="{Binding MemberCode}" Width="60" />
                <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="160" />
                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120" />
                <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="100" />
                <DataGridTextColumn Header="R/N" Binding="{Binding RollRegNo}" Width="100" />
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="100" />
                <DataGridTextColumn Header="Clubs" Binding="{Binding Clubs}" Width="170" />
                <DataGridTextColumn Header="Badge" Binding="{Binding Badge}" Width="70" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                <DataGridTextColumn Header="Registered" Binding="{Binding Registered}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>

