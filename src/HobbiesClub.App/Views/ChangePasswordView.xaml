<UserControl x:Class="HobbiesClub.App.Views.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HobbiesClub.App.Views"
             xmlns:helpers="clr-namespace:HobbiesClub.App.Helpers">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="440" Padding="36" CornerRadius="18"
                VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
            <StackPanel>
                <TextBlock Text="Change your password" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="You must set a new password before continuing." Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,22" />

                <TextBlock Text="Current password" Style="{StaticResource Label}" />
                <views:PasswordField Password="{Binding CurrentPassword, Mode=TwoWay}" Margin="0,0,0,14" />
                <TextBlock Text="New password (at least 8 characters)" Style="{StaticResource Label}" />
                <views:PasswordField Password="{Binding NewPassword, Mode=TwoWay}" Margin="0,0,0,14" />
                <TextBlock Text="Confirm new password" Style="{StaticResource Label}" />
                <views:PasswordField Password="{Binding ConfirmPassword, Mode=TwoWay}" Margin="0,0,0,14" />

                <TextBlock Text="{Binding Error}" helpers:AutoHide.Seconds="6" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <Button Content="Change password" Command="{Binding ChangeCommand}" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Height="48" FontSize="15" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Height="44" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
