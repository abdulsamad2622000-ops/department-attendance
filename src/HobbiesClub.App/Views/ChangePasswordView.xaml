<UserControl xmlns:helpers="clr-namespace:HobbiesClub.App.Helpers" x:Class="HobbiesClub.App.Views.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HobbiesClub.App.Views">
    <StackPanel Width="340" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Change your password" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock Text="You must set a new password before continuing." Foreground="Gray"
                   TextWrapping="Wrap" Margin="0,0,0,16" />
        <TextBlock Text="Current password" />
        <views:PasswordField Password="{Binding CurrentPassword, Mode=TwoWay}" Margin="0,2,0,10" />
        <TextBlock Text="New password (at least 8 characters)" />
        <views:PasswordField Password="{Binding NewPassword, Mode=TwoWay}" Margin="0,2,0,10" />
        <TextBlock Text="Confirm new password" />
        <views:PasswordField Password="{Binding ConfirmPassword, Mode=TwoWay}" Margin="0,2,0,10" />
        <TextBlock Text="{Binding Error}" helpers:AutoHide.Seconds="6" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Button Content="Change password" Command="{Binding ChangeCommand}" Padding="8" IsDefault="True" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="8" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>

