<UserControl xmlns:helpers="clr-namespace:HobbiesClub.App.Helpers" x:Class="HobbiesClub.App.Views.AdminShellView" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HobbiesClub.App.Views"
             xmlns:app="clr-namespace:HobbiesClub.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="UB2V" />

        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Sidebar menu item (icon comes from Tag) -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="14,11" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="Ic" Style="{StaticResource NavIcon}" Stroke="#C7D2E5" Margin="0,0,12,0"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter x:Name="Hdr" ContentSource="Header" VerticalAlignment="Center" TextElement.Foreground="#C7D2E5" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12386E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarActiveBrush}" />
                                <Setter TargetName="Ic" Property="Stroke" Value="White" />
                                <Setter TargetName="Hdr" Property="TextElement.Foreground" Value="White" />
                                <Setter TargetName="Hdr" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <TabControl FontSize="14" Background="Transparent" BorderThickness="0" Padding="0">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Top header -->
                    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource PrimaryBrush}" BorderBrush="#1E4A80" BorderThickness="0,0,0,1" Padding="20,0,28,0" TextElement.Foreground="White">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="19" Background="#D3DEEF">
                                    <TextBlock Text="{Binding DisplayInitial}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                    <TextBlock Text="Super Admin" FontSize="12" Foreground="{StaticResource GoldBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="46" Height="46" CornerRadius="23" Background="#071A33" BorderBrush="{StaticResource GoldBrush}" BorderThickness="2">
                                    <Ellipse Margin="3"><Ellipse.Fill><ImageBrush ImageSource="{Binding LoginLogo, Source={x:Static helpers:BrandingSource.Instance}}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HeaderTitle, Source={x:Static helpers:BrandingSource.Instance}}" FontSize="17" FontWeight="Bold" />
                                    <TextBlock Text="{Binding HeaderSubtitle, Source={x:Static helpers:BrandingSource.Instance}}" FontSize="12" Foreground="#C7D2E5" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Sidebar -->
                    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="14,20" TextElement.Foreground="White">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom">
                                <Button Command="{Binding LogoutCommand}" Height="44" Background="Transparent" Foreground="#C7D2E5" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Stroke="#C7D2E5" Margin="0,0,12,0" Data="M15,4 H19 V20 H15 M10,8 L6,12 L10,16 M6,12 H16" />
                                        <TextBlock Text="Log out" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{x:Static app:AppInfo.VersionText}" FontSize="11" Foreground="#7F93B3" Margin="14,8,0,0" />
                            </StackPanel>
                            <StackPanel IsItemsHost="True" />
                        </DockPanel>
                    </Border>

                    <!-- Content -->
                    <ContentPresenter Grid.Row="1" Grid.Column="1" ContentSource="SelectedContent" Margin="32,28" TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontWeight="Normal" />
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <TabItem Header="Dashboard" Tag="M3,11 L12,4 L21,11 M5,10 V20 H10 V14 H14 V20 H19 V10">
            <views:DashboardView DataContext="{Binding Dashboard}" />
        </TabItem>

        <TabItem Header="Members" Tag="M9,11 A3.5,3.5 0 1 0 9,4 A3.5,3.5 0 1 0 9,11 M2.5,20 C2.5,16 5.5,14 9,14 C12.5,14 15.5,16 15.5,20 M16,4.5 A3,3 0 0 1 16,10.5 M18,14.5 C20,15.2 21.5,17 21.5,20">
            <views:MembersView DataContext="{Binding Members}" />
        </TabItem>

        <TabItem Header="Reports" Tag="M6,3 H14 L19,8 V21 H6 Z M14,3 V8 H19 M9,17 V13 M12.5,17 V11 M16,17 V14">
            <views:ReportsView DataContext="{Binding Reports}" />
        </TabItem>

        <TabItem Header="Users" Tag="M12,3 L19,6 V11 C19,15.5 16,19 12,21 C8,19 5,15.5 5,11 V6 Z M12,9 A2,2 0 1 0 12,13 A2,2 0 1 0 12,9">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Users" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Staff accounts that can sign in" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- Create user -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" CornerRadius="16" Padding="22,20" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Create user" FontSize="18" FontWeight="Bold" Margin="0,0,0,14" />
                            <TextBlock Text="Full name" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" Height="42" Margin="0,0,0,12" />
                            <TextBlock Text="Username" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Height="42" Margin="0,0,0,12" />
                            <TextBlock Text="Password (at least 8 characters)" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                            <views:PasswordField Password="{Binding NewPassword, Mode=TwoWay}" Margin="0,0,0,12" />
                            <TextBlock Text="Role" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" Height="42" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding Error}" helpers:AutoHide.Seconds="6" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Message}" helpers:AutoHide.Seconds="6" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <Button Content="Create user" Command="{Binding CreateUserCommand}" Style="{StaticResource PrimaryButton}" Height="44" />
                        </StackPanel>
                    </Border>

                    <!-- List + edit -->
                    <DockPanel Grid.Column="0">
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" CornerRadius="16" Padding="22,18" Margin="0,14,0,0"
                                Visibility="{Binding HasSelectedUser, Converter={StaticResource UB2V}}">
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="Bold"><Run Text="Edit user: " /><Run Text="{Binding SelectedUser.Username, Mode=OneWay}" /></TextBlock>
                                <WrapPanel Margin="0,12,0,0">
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="Full name" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding EditUserFullName, UpdateSourceTrigger=PropertyChanged}" Width="240" Height="42" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="Role" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding EditUserRole}" Width="160" Height="42" VerticalContentAlignment="Center" Padding="10,0" />
                                    </StackPanel>
                                    <CheckBox Content="Active (can log in)" IsChecked="{Binding EditUserActive}" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                                </WrapPanel>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Save changes" Command="{Binding SaveUserCommand}" Style="{StaticResource PrimaryButton}" Height="42" Padding="18,0" Margin="0,0,10,0" />
                                    <Button Content="Reset password" Command="{Binding ResetUserPasswordCommand}" Height="42" Padding="18,0" Margin="0,0,10,0" />
                                    <Button Content="Unlock account" Command="{Binding UnlockUserCommand}" Height="42" Padding="18,0" />
                                </WrapPanel>
                                <TextBlock Text="{Binding UserError}" helpers:AutoHide.Seconds="6" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding UserMessage}" helpers:AutoHide.Seconds="6" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" CornerRadius="16" Padding="0">
                            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" CanUserAddRows="False" RowHeight="48" BorderThickness="0" Margin="0,6,0,6">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="160">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
                                    <DataGridTemplateColumn Header="Role" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Role, Converter={StaticResource PillBg}}" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Role}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Role, Converter={StaticResource PillFg}}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Status" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Active}" Value="Yes">
                                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Inactive" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Active}" Value="Yes">
                                                                        <Setter Property="Text" Value="Active" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </TabItem>

        <TabItem Header="Activity log" Tag="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M12,7 V12 L15,14">
            <views:ActivityLogView DataContext="{Binding ActivityLog}" />
        </TabItem>

        <TabItem Header="Backup" Tag="M4,6 C4,4 20,4 20,6 C20,8 4,8 4,6 Z M4,6 V18 C4,20 20,20 20,18 V6 M4,12 C4,14 20,14 20,12">
            <views:BackupView DataContext="{Binding Backup}" />
        </TabItem>

        <TabItem Header="Settings" Tag="M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9 M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9">
            <views:SettingsView />
        </TabItem>

        <TabItem Header="Branding" Tag="M4,5 H20 V19 H4 Z M4,15 L9,10 L13,14 L16,11 L20,15 M15,7 A1.5,1.5 0 1 0 15,10 A1.5,1.5 0 1 0 15,7">
            <views:BrandingView />
        </TabItem>
    </TabControl>
</UserControl>




