<UserControl xmlns:helpers="clr-namespace:HobbiesClub.App.Helpers" x:Class="HobbiesClub.App.Views.AdminShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HobbiesClub.App.Views">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="UB2V" /></UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="Log out" Command="{Binding LogoutCommand}" Padding="12,6" HorizontalAlignment="Right" />
        </Grid>

        <TabControl Grid.Row="1" FontSize="14">
            <TabItem Header="Dashboard" Padding="14,6">
                <views:DashboardView DataContext="{Binding Dashboard}" Margin="10" />
            </TabItem>

            <TabItem Header="Members" Padding="14,6">
                <views:MembersView DataContext="{Binding Members}" Margin="10" />
            </TabItem>

            <TabItem Header="Reports" Padding="14,6">
                <views:ReportsView DataContext="{Binding Reports}" Margin="10" />
            </TabItem>

            <TabItem Header="Users" Padding="14,6">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Create user" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Full name" />
                        <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="4" />
                        <TextBlock Text="Username" />
                        <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="4" />
                        <TextBlock Text="Password (at least 8 characters)" />
                        <views:PasswordField Password="{Binding NewPassword, Mode=TwoWay}" Margin="0,2,0,8" />
                        <TextBlock Text="Role" />
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" Margin="0,2,0,8" Padding="4" />
                        <TextBlock Text="{Binding Error}" helpers:AutoHide.Seconds="6" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding Message}" helpers:AutoHide.Seconds="6" Foreground="SeaGreen" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <Button Content="Create user" Command="{Binding CreateUserCommand}" Padding="8" />
                    </StackPanel>

                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Users" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Border DockPanel.Dock="Bottom" BorderBrush="LightGray" BorderThickness="1" Padding="12" Margin="0,10,0,0"
                                Visibility="{Binding HasSelectedUser, Converter={StaticResource UB2V}}">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold"><Run Text="Edit user: " /><Run Text="{Binding SelectedUser.Username, Mode=OneWay}" /></TextBlock>
                                <WrapPanel Margin="0,8,0,0">
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Full name" />
                                        <TextBox Text="{Binding EditUserFullName, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="4" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Role" />
                                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding EditUserRole}" Width="150" Padding="4" />
                                    </StackPanel>
                                    <CheckBox Content="Active (can log in)" IsChecked="{Binding EditUserActive}" VerticalAlignment="Bottom" Margin="0,0,16,6" />
                                </WrapPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Save changes" Command="{Binding SaveUserCommand}" Padding="12,6" Margin="0,0,8,0" FontWeight="SemiBold" />
                                    <Button Content="Reset password" Command="{Binding ResetUserPasswordCommand}" Padding="12,6" Margin="0,0,8,0" />
                                    <Button Content="Unlock account" Command="{Binding UnlockUserCommand}" Padding="12,6" />
                                </WrapPanel>
                                <TextBlock Text="{Binding UserError}" helpers:AutoHide.Seconds="6" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding UserMessage}" helpers:AutoHide.Seconds="6" Foreground="SeaGreen" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="100" />
                                <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="140" />
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90" />
                                <DataGridTextColumn Header="Active" Binding="{Binding Active}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Activity log" Padding="14,6">
                <views:ActivityLogView DataContext="{Binding ActivityLog}" Margin="10" />
            </TabItem>
            <TabItem Header="Backup" Padding="14,6">
                <views:BackupView DataContext="{Binding Backup}" Margin="10" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>


