<UserControl x:Class="HobbiesClub.App.Views.PasswordField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <PasswordBox x:Name="HiddenBox" Padding="4" PasswordChanged="OnHiddenChanged" />
        <TextBox x:Name="VisibleBox" Padding="4" Visibility="Collapsed" TextChanged="OnVisibleChanged" />
        <CheckBox x:Name="ShowCheck" Grid.Column="1" Content="Show" VerticalAlignment="Center"
                  Margin="8,0,0,0" Checked="OnToggle" Unchecked="OnToggle" />
    </Grid>
</UserControl>
