<UserControl x:Class="HobbiesClub.App.Views.PasswordField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <PasswordBox x:Name="HiddenBox" Height="44" PasswordChanged="OnHiddenChanged" />
            <TextBox x:Name="VisibleBox" Height="44" Visibility="Collapsed" TextChanged="OnVisibleChanged" />
            <TextBlock x:Name="Hint" Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#94A3B8" FontSize="15" VerticalAlignment="Center" Margin="3,0,0,0" IsHitTestVisible="False" />
        </Grid>
        <CheckBox x:Name="ShowCheck" Content="Show password" FontSize="13" HorizontalAlignment="Left"
                  Margin="2,8,0,0" Checked="OnToggle" Unchecked="OnToggle" />
    </StackPanel>
</UserControl>


