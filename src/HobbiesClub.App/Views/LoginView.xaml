<UserControl x:Class="HobbiesClub.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HobbiesClub.App.Views"
             xmlns:helpers="clr-namespace:HobbiesClub.App.Helpers"
             xmlns:app="clr-namespace:HobbiesClub.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BrandB2V" />
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldIcon" TargetType="Path">
            <Setter Property="Stroke" Value="#64748B" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

<Grid ClipToBounds="True">
    <views:ShipSlideshow />
    <Image Source="{Binding LoginBackground, Source={x:Static helpers:BrandingSource.Instance}}" Stretch="UniformToFill" Visibility="{Binding HasCustomLoginBg, Source={x:Static helpers:BrandingSource.Instance}, Converter={StaticResource BrandB2V}}" />
    <Rectangle>
        <Rectangle.Fill>
            <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                <GradientStop Color="#D9071A33" Offset="0" />
                <GradientStop Color="#80071A33" Offset="0.3" />
                <GradientStop Color="#00071A33" Offset="0.55" />
            </LinearGradientBrush>
        </Rectangle.Fill>
    </Rectangle>
    <Rectangle Visibility="{Binding ShowLeft, Source={x:Static helpers:BrandingSource.Instance}, Converter={StaticResource BrandB2V}}">
        <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#D9071A33" Offset="0" />
                <GradientStop Color="#80071A33" Offset="0.3" />
                <GradientStop Color="#00071A33" Offset="0.55" />
            </LinearGradientBrush>
        </Rectangle.Fill>
    </Rectangle>
    <Rectangle Height="120" VerticalAlignment="Bottom">
        <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00071A33" Offset="0" />
                <GradientStop Color="#CC071A33" Offset="1" />
            </LinearGradientBrush>
        </Rectangle.Fill>
    </Rectangle>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" VerticalAlignment="Center" Margin="90,30,90,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- LEFT block: same as the right block, without the login card -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top" MaxWidth="620" IsHitTestVisible="False" Visibility="{Binding ShowLeft, Source={x:Static helpers:BrandingSource.Instance}, Converter={StaticResource BrandB2V}}">
                <Grid HorizontalAlignment="Center" Width="110" Height="110" Visibility="{Binding HasLeftLogo, Source={x:Static helpers:BrandingSource.Instance}, Converter={StaticResource BrandB2V}}">
                    <Grid.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="#000000" /></Grid.Effect>
                    <Ellipse Fill="#071A33" Stroke="#C9A227" StrokeThickness="3" />
                    <Ellipse Margin="6"><Ellipse.Fill><ImageBrush ImageSource="{Binding LeftLogo, Source={x:Static helpers:BrandingSource.Instance}}" Stretch="Uniform" /></Ellipse.Fill></Ellipse>
                </Grid>
                <TextBlock Text="{Binding LeftHeading, Source={x:Static helpers:BrandingSource.Instance}}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,2" Visibility="{Binding HasLeftHeading, Source={x:Static helpers:BrandingSource.Instance}, Converter={StaticResource BrandB2V}}">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.7" Color="#000000" /></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{Binding LeftSubtitle, Source={x:Static helpers:BrandingSource.Instance}}" FontSize="16" Foreground="#E2E8F0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Visibility="{Binding HasLeftSubtitle, Source={x:Static helpers:BrandingSource.Instance}, Converter={StaticResource BrandB2V}}">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.7" Color="#000000" /></TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <!-- RIGHT block -->
            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <Grid HorizontalAlignment="Center" Width="110" Height="110">
                    <Grid.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="#000000" /></Grid.Effect>
                    <Ellipse Fill="#071A33" Stroke="#C9A227" StrokeThickness="3" />
                    <Ellipse Margin="6"><Ellipse.Fill><ImageBrush ImageSource="{Binding LoginLogo, Source={x:Static helpers:BrandingSource.Instance}}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse>
                </Grid>
                <TextBlock Text="{Binding Heading, Source={x:Static helpers:BrandingSource.Instance}}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="720" Margin="0,16,0,2" Visibility="{Binding HasHeading, Source={x:Static helpers:BrandingSource.Instance}, Converter={StaticResource BrandB2V}}">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.7" Color="#000000" /></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{Binding Subtitle, Source={x:Static helpers:BrandingSource.Instance}}" FontSize="16" Foreground="#E2E8F0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="720" Visibility="{Binding HasSubtitle, Source={x:Static helpers:BrandingSource.Instance}, Converter={StaticResource BrandB2V}}" />

                <Border Background="#F2FFFFFF" CornerRadius="16" Padding="36,32" Width="440" Margin="0,26,0,0" HorizontalAlignment="Center">
                    <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.45" Color="#000000" /></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Welcome Back" FontSize="26" FontWeight="Bold" Foreground="#0B2A55" HorizontalAlignment="Center" />
                        <TextBlock Text="Please login to continue" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,24" />
                        <Border Style="{StaticResource FieldBox}" Margin="0,0,0,14">
                            <DockPanel>
                                <Path Style="{StaticResource FieldIcon}" Data="M12,12 A4,4 0 1 0 12,4 A4,4 0 1 0 12,12 M4,21 C4,16.6 7.6,14 12,14 C16.4,14 20,16.6 20,21" />
                                <Grid>
                                    <TextBlock Text="Username" Foreground="#94A3B8" FontSize="15" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Username}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Username}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource FieldBox}" Height="Auto" Padding="14,10" Margin="0,0,0,14"><DockPanel><Path Style="{StaticResource FieldIcon}" VerticalAlignment="Top" Margin="0,6,12,0" Data="M6,11 H18 V21 H6 Z M8,11 V7 A4,4 0 0 1 16,7 V11" /><views:PasswordField Password="{Binding Password, Mode=TwoWay}" Placeholder="Password" /></DockPanel></Border>
                        <TextBlock Text="{Binding Error}" helpers:AutoHide.Seconds="6" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Button Content="Login" Command="{Binding LoginCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}" Height="50" FontSize="16" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <Ellipse Width="8" Height="8" Fill="#16A34A" VerticalAlignment="Center" />
                            <TextBlock Text="Offline system  &#183;  Authorized personnel only" Foreground="#64748B" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="40,0,40,24">
            <TextBlock Text="{Binding FooterText, Source={x:Static helpers:BrandingSource.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static app:AppInfo.VersionText}" FontSize="12" Foreground="#9FB3D1" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Grid>
</UserControl>


