<Window x:Class="HobbiesClub.App.Views.FingerEnrollDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HobbiesClub.App.Views"
        Title="Fingerprints" Width="980" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Margin="20" CornerRadius="24" Padding="32,28" Background="{StaticResource NavyGradient}" BorderBrush="#1E4A80" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="#000000" /></Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Register fingerprints" FontSize="24" FontWeight="Bold" Foreground="White" />
            <TextBlock x:Name="SubtitleText" Text="Tap a finger, then place it on the scanner." FontSize="15" Foreground="#93C5FD" Margin="0,4,0,20" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#0E3263" CornerRadius="18" Padding="16" BorderBrush="#1E4A80" BorderThickness="1">
                    <StackPanel>
                        <views:HandsControl x:Name="Hands" Height="250" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Ellipse Width="10" Height="10" Fill="#3B82F6" VerticalAlignment="Center" />
                            <TextBlock Text="Selected" Foreground="#C7D2E5" FontSize="12" Margin="6,0,16,0" VerticalAlignment="Center" />
                            <Ellipse Width="10" Height="10" Fill="#16A34A" VerticalAlignment="Center" />
                            <TextBlock Text="Registered" Foreground="#C7D2E5" FontSize="12" Margin="6,0,16,0" VerticalAlignment="Center" />
                            <Ellipse Width="10" Height="10" Fill="#1E4A80" Stroke="#4A6FA5" VerticalAlignment="Center" />
                            <TextBlock Text="Not registered" Foreground="#C7D2E5" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#061632" CornerRadius="18" Padding="16" BorderBrush="#1E4A80" BorderThickness="1">
                    <StackPanel>
                        <Grid Height="230" Width="180" HorizontalAlignment="Center" ClipToBounds="True">
                            <Border CornerRadius="16" Background="#0B2A55" BorderBrush="#4FA3E0" BorderThickness="1.5" />
                            <Viewbox x:Name="PrintIcon" Margin="24">
                                <Path Stroke="#4FA3E0" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M30,70 A30,40 0 0 1 90,70 M38,74 A22,30 0 0 1 82,74 M46,78 A14,20 0 0 1 74,78 M54,82 A6,10 0 0 1 66,82 M30,70 V96 M90,70 V100 M38,74 V106 M82,74 V108 M46,78 V112 M74,78 V114 M54,82 V114 M66,82 V116 M60,86 V118" />
                            </Viewbox>
                            <Image x:Name="PrintImage" Stretch="Uniform" Margin="8" Visibility="Collapsed" />
                            <Rectangle x:Name="ScanLine" Height="4" VerticalAlignment="Top" Margin="10,0" Visibility="Collapsed">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#003B82F6" Offset="0" />
                                        <GradientStop Color="#FF3B82F6" Offset="0.5" />
                                        <GradientStop Color="#003B82F6" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform><TranslateTransform x:Name="ScanShift" /></Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Grid Margin="0,12,0,0" Height="8">
                            <Border CornerRadius="4" Background="#12386E" />
                            <Border x:Name="QualityBar" CornerRadius="4" Background="#22C55E" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <TextBlock x:Name="QualityText" Text="Quality —" Foreground="#9FB3D1" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="StatusText" Text="Tap a finger on the hands to start" FontSize="20" FontWeight="SemiBold" Foreground="White"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,6" />
            <TextBlock x:Name="CountText" Text="" FontSize="14" Foreground="#C7D2E5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="RetryButton" Content="Scan again" Width="150" Height="46" Margin="0,0,12,0" Visibility="Collapsed"
                        Background="Transparent" Foreground="White" BorderBrush="#3B82F6" Click="OnRetry" />
                <Button x:Name="RemoveButton" Content="Remove finger" Width="150" Height="46" Margin="0,0,12,0" Visibility="Collapsed"
                        Background="Transparent" Foreground="#FCA5A5" BorderBrush="#B91C1C" Click="OnRemove" />
                <Button x:Name="CancelButton" Content="Cancel" Width="150" Height="46" Margin="0,0,12,0" Background="Transparent" Foreground="White" BorderBrush="#2B5A94" Click="OnCancel" />
                <Button x:Name="SaveButton" Content="Save (0)" Width="170" Height="46" IsEnabled="False"
                        Style="{StaticResource PrimaryButton}" Background="#16A34A" BorderBrush="#16A34A" Foreground="White" Click="OnSave" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

