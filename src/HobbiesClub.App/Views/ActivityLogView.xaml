<UserControl x:Class="HobbiesClub.App.Views.ActivityLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker SelectedDate="{Binding From}" Width="130" />
            <TextBlock Text="To" VerticalAlignment="Center" Margin="12,0,6,0" />
            <DatePicker SelectedDate="{Binding To}" Width="130" />
            <ComboBox ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding ActionFilter}" Width="220"
                      Margin="12,0,0,0" Padding="4" />
            <TextBlock Text="User" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Text="{Binding UserSearch, UpdateSourceTrigger=PropertyChanged}" Width="140" Padding="4" />
            <Button Content="Refresh" Command="{Binding LoadCommand}" Padding="10,4" Margin="12,0,0,0" />
            <TextBlock Text="{Binding Summary}" Foreground="Gray" VerticalAlignment="Center" Margin="16,0,0,0" />
        </WrapPanel>

        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" RowHeight="30">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="200" />
                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="120" />
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="220" />
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
