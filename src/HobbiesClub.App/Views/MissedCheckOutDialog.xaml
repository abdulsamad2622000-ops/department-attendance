<Window x:Class="HobbiesClub.App.Views.MissedCheckOutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Missed check-out" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="Please enter the time you left. Today's check-in cannot be recorded until you do."
                   FontSize="16" TextWrapping="Wrap" Margin="0,8,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <ComboBox x:Name="HourBox" Width="70" FontSize="22" />
            <TextBlock Text=":" FontSize="22" Margin="6,0" VerticalAlignment="Center" />
            <ComboBox x:Name="MinuteBox" Width="70" FontSize="22" />
            <ComboBox x:Name="AmPmBox" Width="80" FontSize="22" Margin="10,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="Firebrick" FontSize="15" TextWrapping="Wrap"
                   HorizontalAlignment="Center" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="Confirm" IsDefault="True" Click="OnConfirm" FontSize="20" Padding="24,8" Margin="0,0,10,0" />
            <Button Content="Cancel" IsCancel="True" FontSize="20" Padding="24,8" />
        </StackPanel>
    </StackPanel>
</Window>
