<Window x:Class="HobbiesClub.App.Views.MissedCheckOutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Missed check-out" Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Margin="24" Background="White" CornerRadius="24" Padding="32">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.18" Color="#0F172A" />
        </Border.Effect>
        <StackPanel>
            <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource WarningSoftBrush}" HorizontalAlignment="Left">
                <TextBlock Text="!" FontSize="32" FontWeight="ExtraBold" Foreground="#B45309"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="Heading" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Margin="0,16,0,0" />
            <TextBlock Text="Please enter the time you left. Today's check-in cannot be recorded until you do."
                       FontSize="15" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,20" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ComboBox x:Name="HourBox" Width="84" Height="52" FontSize="22" VerticalContentAlignment="Center" />
                <TextBlock Text=":" FontSize="26" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center" />
                <ComboBox x:Name="MinuteBox" Width="84" Height="52" FontSize="22" VerticalContentAlignment="Center" />
                <ComboBox x:Name="AmPmBox" Width="96" Height="52" FontSize="22" Margin="14,0,0,0" VerticalContentAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Note (optional)" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,18,0,6" />
            <TextBox x:Name="NoteBox" Height="70" FontSize="15" TextWrapping="Wrap" AcceptsReturn="False" MaxLength="200" VerticalContentAlignment="Top" Padding="8" />
            <TextBlock Text="For example: forgot to check out, or left early for an emergency." FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="14" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,14,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" FontSize="16" Height="50" Width="130" Margin="0,0,12,0" />
                <Button Content="Confirm" IsDefault="True" Click="OnConfirm" Style="{StaticResource PrimaryButton}"
                        FontSize="16" Height="50" Width="150" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>


