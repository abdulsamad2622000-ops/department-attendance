<UserControl Foreground="{StaticResource TextBrush}" x:Class="HobbiesClub.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="42" />
            <Setter Property="MaxLength" Value="40" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Rename the member detail fields used across the app" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <Border Style="{StaticResource Card}" CornerRadius="16" Padding="24,22" Width="520" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Field labels" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Text="Leave a box empty to use the default name." FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16" />

                <TextBlock Text="Field 1 (default: Full name)" Style="{StaticResource SLabel}" />
                <TextBox x:Name="TxtName" Style="{StaticResource SBox}" />
                <TextBlock Text="Field 2 (default: Unit)" Style="{StaticResource SLabel}" />
                <TextBox x:Name="TxtUnit" Style="{StaticResource SBox}" />
                <TextBlock Text="Field 3 (default: Rank)" Style="{StaticResource SLabel}" />
                <TextBox x:Name="TxtRank" Style="{StaticResource SBox}" />
                <TextBlock Text="Field 4 (default: R/N)" Style="{StaticResource SLabel}" />
                <TextBox x:Name="TxtRoll" Style="{StaticResource SBox}" />
                <TextBlock Text="Field 5 (default: Phone)" Style="{StaticResource SLabel}" />
                <TextBox x:Name="TxtPhone" Style="{StaticResource SBox}" />

                <TextBlock x:Name="Msg" TextWrapping="Wrap" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Click="Save_Click" Style="{StaticResource PrimaryButton}" Height="44" Padding="26,0" Margin="0,0,10,0" />
                    <Button Content="Reset to default" Click="Reset_Click" Height="44" Padding="18,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>


