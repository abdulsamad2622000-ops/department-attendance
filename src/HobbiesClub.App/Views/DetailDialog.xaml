<Window x:Class="HobbiesClub.App.Views.DetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="860" Height="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize">
    <DockPanel Margin="20">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
        <Button DockPanel.Dock="Bottom" Content="Close" IsCancel="True" IsDefault="True" Click="OnClose"
                HorizontalAlignment="Right" Padding="24,6" Margin="0,12,0,0" />
        <Grid>
            <DataGrid x:Name="RowsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" RowHeight="46" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="38" Height="38">
                                    <Ellipse Fill="#FF3B5BA9" />
                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ID" Binding="{Binding MemberCode}" Width="60" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
                    <DataGridTextColumn Header="Club" Binding="{Binding Club}" Width="170" />
                    <DataGridTextColumn Header="Time" Binding="{Binding When}" Width="140" />
                    <DataGridTextColumn Header="Details" Binding="{Binding Info}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Text="No records." Foreground="Gray" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </DockPanel>
</Window>

