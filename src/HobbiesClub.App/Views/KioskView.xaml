<UserControl x:Class="HobbiesClub.App.Views.KioskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:HobbiesClub.App">
    <UserControl.Resources>
        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Style x:Key="BigChoice" TargetType="Button">
            <Setter Property="Width" Value="300" />
            <Setter Property="Height" Value="210" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#1E4A80" />
            <Setter Property="Foreground" Value="#0B2A55" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="20">
                            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="#000000" /></Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12386E" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C9A227" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#071A33" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChoiceTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Style x:Key="ChoiceHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#071A33" Offset="0" />
                <GradientStop Color="#0B2A55" Offset="0.6" />
                <GradientStop Color="#0E3263" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="40,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right" Command="{Binding AdminCommand}" Height="44" Padding="16,0" VerticalAlignment="Center"
                        Background="Transparent" Foreground="White" BorderBrush="#2B5A94">
                    <StackPanel Orientation="Horizontal">
                        <Canvas Width="24" Height="24" Margin="0,0,8,0">
                            <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M9,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 H9 M16,17 L21,12 L16,7 M21,12 H9" />
                        </Canvas>
                        <TextBlock Text="Log out" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <Border Width="60" Height="60" CornerRadius="30" Background="#071A33" BorderBrush="#C9A227" BorderThickness="2">
                        <Ellipse Margin="3"><Ellipse.Fill><ImageBrush ImageSource="/Assets/navy-logo.png" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Fleet Hobbies &amp; AI Club" FontSize="22" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Member check-in" FontSize="14" Foreground="#C9A227" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Main -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding ClockText}" FontSize="88" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DateText}" FontSize="22" Foreground="#C7D2E5" HorizontalAlignment="Center" Margin="0,4,0,36" />
                <TextBlock Text="Choose how you'd like to check in or out" FontSize="17" Foreground="#9FB3D1" HorizontalAlignment="Center" Margin="0,0,0,20" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource BigChoice}" Command="{Binding FaceScanCommand}">
                        <StackPanel>
                            <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource Icon}" Data="M4,8 V6 A2,2 0 0 1 6,4 H8 M16,4 H18 A2,2 0 0 1 20,6 V8 M20,16 V18 A2,2 0 0 1 18,20 H16 M8,20 H6 A2,2 0 0 1 4,18 V16 M15,10 A3,3 0 1 1 9,10 A3,3 0 1 1 15,10 M7.5,17 A5,5 0 0 1 16.5,17" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Face scan" Style="{StaticResource ChoiceTitle}" />
                            <TextBlock Text="Look at the camera" Style="{StaticResource ChoiceHint}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BigChoice}" Command="{Binding FingerprintCommand}">
                        <StackPanel>
                            <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource Icon}" Data="M12,11 V14 A8,8 0 0 1 11,18 M8.5,7.5 A5,5 0 0 1 17,11 V13 M9,12 V13 A12,12 0 0 1 7.5,19 M15,14 A15,15 0 0 1 14.2,19 M4.5,15 A10,10 0 0 0 5,12 V11 A7,7 0 0 1 17,6" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Fingerprint" Style="{StaticResource ChoiceTitle}" />
                            <TextBlock Text="Place your finger" Style="{StaticResource ChoiceHint}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BigChoice}" Command="{Binding PinCommand}">
                        <StackPanel>
                            <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource Icon}" Data="M5,6 H19 A2,2 0 0 1 21,8 V16 A2,2 0 0 1 19,18 H5 A2,2 0 0 1 3,16 V8 A2,2 0 0 1 5,6 Z M7,12 H7.01 M11,12 H11.01 M15,12 H15.01" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="PIN" Style="{StaticResource ChoiceTitle}" />
                            <TextBlock Text="Enter 4-digit PIN" Style="{StaticResource ChoiceHint}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding Status}" FontSize="20" FontWeight="SemiBold" Foreground="#F5D76E"
                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,24,0,0" />

                <Button Command="{Binding RegisterCommand}" Background="Transparent" BorderThickness="0"
                        Foreground="#C9A227" FontSize="17" Padding="20,12"
                        HorizontalAlignment="Center" Margin="0,12,0,0" Content="New member? Register here" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="{x:Static app:AppInfo.VersionText}" Foreground="#9FB3D1" FontSize="12" HorizontalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
