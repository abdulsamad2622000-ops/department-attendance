<UserControl x:Class="HobbiesClub.App.Views.KioskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Button Content="Log out" Command="{Binding AdminCommand}" Padding="12,6"
                HorizontalAlignment="Right" VerticalAlignment="Top" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="36" FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ClockText}" FontSize="48" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,10,0,0" />
            <TextBlock Text="{Binding DateText}" FontSize="18" Foreground="Gray"
                       HorizontalAlignment="Center" Margin="0,0,0,30" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Face Scan" Command="{Binding FaceScanCommand}"
                        Width="180" Height="100" FontSize="22" Margin="10" />
                <Button Content="Fingerprint" Command="{Binding FingerprintCommand}"
                        Width="180" Height="100" FontSize="22" Margin="10" />
                <Button Content="PIN" Command="{Binding PinCommand}"
                        Width="180" Height="100" FontSize="22" Margin="10" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" FontSize="18" Foreground="Firebrick"
                       HorizontalAlignment="Center" Margin="0,20,0,0" />
            <Button Content="New member? Register" Command="{Binding RegisterCommand}"
                    FontSize="16" Padding="16,8" HorizontalAlignment="Center" Margin="0,24,0,0" />
        </StackPanel>
    </Grid>
</UserControl>

