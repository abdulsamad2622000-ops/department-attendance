<UserControl x:Class="HobbiesClub.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HobbiesClub.App.Views"
             xmlns:helpers="clr-namespace:HobbiesClub.App.Helpers"
             xmlns:app="clr-namespace:HobbiesClub.App">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Border Width="48" Height="48" CornerRadius="13" Background="{StaticResource PrimaryBrush}">
                    <TextBlock Text="H&amp;AI" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Hobbies Club &amp; AI Club" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Width="460" Padding="36" CornerRadius="18">
                <StackPanel>
                    <TextBlock Text="Welcome! Let's set up" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="Create the first Super Admin account. You can add kiosk and staff accounts later."
                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,22" />

                    <TextBlock Text="Full name" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="44" Margin="0,0,0,14" />
                    <TextBlock Text="Username" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="44" Margin="0,0,0,14" />
                    <TextBlock Text="Password (at least 8 characters)" Style="{StaticResource Label}" />
                    <views:PasswordField Password="{Binding Password, Mode=TwoWay}" Margin="0,0,0,14" />
                    <TextBlock Text="Confirm password" Style="{StaticResource Label}" />
                    <views:PasswordField Password="{Binding ConfirmPassword, Mode=TwoWay}" Margin="0,0,0,14" />

                    <TextBlock Text="{Binding Error}" helpers:AutoHide.Seconds="6" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Button Content="Create Super Admin" Command="{Binding CreateCommand}" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Height="48" FontSize="15" />
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Static app:AppInfo.VersionText}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
