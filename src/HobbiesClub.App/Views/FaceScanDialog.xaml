<Window x:Class="HobbiesClub.App.Views.FaceScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Face scan" Width="900" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="StepPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="#0E3263" />
            <Setter Property="BorderBrush" Value="#1E4A80" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
    </Window.Resources>
    <Border Margin="20" CornerRadius="24" Padding="32,28" Background="{StaticResource NavyGradient}" BorderBrush="#1E4A80" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="#000000" /></Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Face scan" FontSize="24" FontWeight="Bold" Foreground="White" />
            <TextBlock x:Name="SubtitleText" Text="Follow the steps on the right" FontSize="15" Foreground="#C9A227" Margin="0,4,0,20" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Camera circle -->
                <Grid Width="400" Height="400">
                    <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="5" />
                    <Grid Width="380" Height="380">
                        <Grid.Clip><EllipseGeometry Center="190,190" RadiusX="190" RadiusY="190" /></Grid.Clip>
                        <Rectangle Fill="#061632" />
                        <Viewbox Stretch="UniformToFill">
                            <Grid x:Name="FrameGrid" Width="640" Height="480" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><ScaleTransform ScaleX="-1" /></Grid.RenderTransform>
                                <Image x:Name="CameraImage" Stretch="Fill" />
                                <Canvas x:Name="Overlay" />
                            </Grid>
                        </Viewbox>
                        <Rectangle x:Name="ScanLine" Height="4" VerticalAlignment="Top">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#00C9A227" Offset="0" />
                                    <GradientStop Color="#FFC9A227" Offset="0.5" />
                                    <GradientStop Color="#00C9A227" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform><TranslateTransform x:Name="ScanShift" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <TextBlock x:Name="ArrowLeft" Text="◀" FontSize="64" Foreground="#C9A227" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="ArrowRight" Text="▶" FontSize="64" Foreground="#C9A227" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed" />
                        <Border x:Name="DoneBadge" Width="120" Height="120" CornerRadius="60" Background="#CC16A34A" Visibility="Collapsed">
                            <TextBlock Text="✓" FontSize="70" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>

                <!-- Steps -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Border x:Name="Step1" Style="{StaticResource StepPill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Step1Mark" Text="1" Width="28" FontSize="18" FontWeight="Bold" Foreground="#C9A227" />
                            <TextBlock Text="Look straight at the camera" FontSize="16" Foreground="White" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="Step2" Style="{StaticResource StepPill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Step2Mark" Text="2" Width="28" FontSize="18" FontWeight="Bold" Foreground="#9FB3D1" />
                            <TextBlock Text="Turn your head LEFT  ←" FontSize="16" Foreground="White" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="Step3" Style="{StaticResource StepPill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Step3Mark" Text="3" Width="28" FontSize="18" FontWeight="Bold" Foreground="#9FB3D1" />
                            <TextBlock Text="Turn your head RIGHT  →" FontSize="16" Foreground="White" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Good light on your face helps. Remove cap or dark glasses." FontSize="13" Foreground="#9FB3D1" TextWrapping="Wrap" Margin="2,8,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="StatusText" Text="Starting camera…" FontSize="22" FontWeight="SemiBold" Foreground="White"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,18" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="RetryButton" Content="Try again" Width="150" Height="46" Margin="0,0,12,0" Visibility="Collapsed"
                        Style="{StaticResource PrimaryButton}" Background="#C9A227" BorderBrush="#C9A227" Foreground="#071A33" Click="OnRetry" />
                <Button x:Name="CancelButton" Content="Cancel" Width="150" Height="46" Background="Transparent" Foreground="White" BorderBrush="#2B5A94" Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
