<UserControl x:Class="HobbiesClub.App.Views.RegistrationView" Background="{StaticResource NavyGradient}" Foreground="White"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HobbiesClub.App.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <helpers:StepStateConverter x:Key="StepState" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="BigIcon" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{StaticResource PrimaryBrush}" />
        </Style>
        <Style x:Key="ClubCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="White" BorderBrush="#E2E8F0" BorderThickness="2" CornerRadius="14" Padding="18,16">
                            <DockPanel>
                                <Border x:Name="Tick" DockPanel.Dock="Right" Width="30" Height="30" CornerRadius="15" BorderBrush="#CBD5E1" BorderThickness="2" Background="White" VerticalAlignment="Center">
                                    <Path x:Name="Mark" Data="M7,12 L10.5,15.5 L17,9" Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Visibility="Collapsed" />
                                </Border>
                                <Border Width="50" Height="50" CornerRadius="12" Background="{TemplateBinding Background}" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="22" TextElement.FontWeight="SemiBold" TextElement.Foreground="#0F172A" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="Tick" Property="Background" Value="#16A34A" />
                                <Setter TargetName="Tick" Property="BorderBrush" Value="#16A34A" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Background logo -->
        <Image Grid.RowSpan="3" Margin="-40,-28" Source="{Binding KioskBackground, Source={x:Static helpers:BrandingSource.Instance}}" Stretch="Fill" Opacity="0.15" IsHitTestVisible="False" />

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="DateLine" FontSize="14" Foreground="#C7D2E5" HorizontalAlignment="Right" />
                    <TextBlock x:Name="ClockLine" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="60" Height="60" CornerRadius="30" Background="#071A33" BorderBrush="#C9A227" BorderThickness="2">
                        <Ellipse Margin="3"><Ellipse.Fill><ImageBrush ImageSource="{Binding LoginLogo, Source={x:Static helpers:BrandingSource.Instance}}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderTitle, Source={x:Static helpers:BrandingSource.Instance}}" FontSize="22" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="{Binding HeaderSubtitle, Source={x:Static helpers:BrandingSource.Instance}}" FontSize="14" Foreground="#C7D2E5" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
            <Button Command="{Binding BackCommand}" Background="Transparent" BorderThickness="0" Foreground="White" Padding="4,6" Margin="0,22,0,0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M19,12 H5 M11,6 L5,12 L11,18" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="New Member Registration" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Progress -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,22">
            <StackPanel.Resources>
                <Style TargetType="StackPanel">
                    <Setter Property="Orientation" Value="Horizontal" />
                    <Setter Property="Margin" Value="12,0" />
                </Style>
            </StackPanel.Resources>
            <StackPanel>
                <Border Width="34" Height="34" CornerRadius="17" Background="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=1-1|fill}">
                    <TextBlock Text="1" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=1-1|fg}" />
                </Border>
                <TextBlock Text="Details" Margin="8,0,0,0" FontSize="15" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=1-1|label}" FontWeight="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=1-1|weight}" />
            </StackPanel>
            <Rectangle Width="44" Height="2" Fill="#2B5A94" VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
            <StackPanel>
                <Border Width="34" Height="34" CornerRadius="17" Background="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=2-2|fill}">
                    <TextBlock Text="2" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=2-2|fg}" />
                </Border>
                <TextBlock Text="Clubs" Margin="8,0,0,0" FontSize="15" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=2-2|label}" FontWeight="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=2-2|weight}" />
            </StackPanel>
            <Rectangle Width="44" Height="2" Fill="#2B5A94" VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
            <StackPanel>
                <Border Width="34" Height="34" CornerRadius="17" Background="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=3-4|fill}">
                    <TextBlock Text="3" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=3-4|fg}" />
                </Border>
                <TextBlock Text="PIN" Margin="8,0,0,0" FontSize="15" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=3-4|label}" FontWeight="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=3-4|weight}" />
            </StackPanel>
            <Rectangle Width="44" Height="2" Fill="#2B5A94" VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
            <StackPanel>
                <Border Width="34" Height="34" CornerRadius="17" Background="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=5-5|fill}">
                    <TextBlock Text="4" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=5-5|fg}" />
                </Border>
                <TextBlock Text="Face" Margin="8,0,0,0" FontSize="15" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=5-5|label}" FontWeight="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=5-5|weight}" />
            </StackPanel>
            <Rectangle Width="44" Height="2" Fill="#2B5A94" VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
            <StackPanel>
                <Border Width="34" Height="34" CornerRadius="17" Background="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=6-7|fill}">
                    <TextBlock Text="5" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=6-7|fg}" />
                </Border>
                <TextBlock Text="Fingerprints" Margin="8,0,0,0" FontSize="15" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=6-7|label}" FontWeight="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=6-7|weight}" />
            </StackPanel>
            <Rectangle Width="44" Height="2" Fill="#2B5A94" VerticalAlignment="Center" RadiusX="1" RadiusY="1" />
            <StackPanel>
                <Border Width="34" Height="34" CornerRadius="17" Background="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=8-8|fill}">
                    <TextBlock Text="6" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=8-8|fg}" />
                </Border>
                <TextBlock Text="Done" Margin="8,0,0,0" FontSize="15" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=8-8|label}" FontWeight="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=8-8|weight}" />
            </StackPanel>
        </StackPanel>

        <!-- Card -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}" Width="640" Padding="32" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding Prompt}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,20" />

                    <!-- Details -->
                    <StackPanel Visibility="{Binding IsDetails, Converter={StaticResource B2V}}">
                        <TextBlock Text="Step 1 of 6 · Enter member details" FontSize="14" Foreground="{StaticResource MutedTextBrush}" Margin="0,-12,0,20" />
                        <TextBlock Text="{Binding Name, Source={x:Static helpers:FieldLabelsSource.Instance}}" Style="{StaticResource FieldLabel}" />
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="50" Margin="0,0,0,14">
                            <DockPanel Margin="14,0,10,0">
                                <Grid>
                                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"  Background="Transparent" BorderThickness="0" FontSize="16" Height="46" Padding="0" VerticalContentAlignment="Center" />
                                </Grid>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="{Binding Unit, Source={x:Static helpers:FieldLabelsSource.Instance}}" Style="{StaticResource FieldLabel}" />
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="50" Margin="0,0,0,14">
                            <DockPanel Margin="14,0,10,0">
                                <Grid>
                                    <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Background="Transparent" BorderThickness="0" FontSize="16" Height="46" Padding="0" VerticalContentAlignment="Center" />
                                </Grid>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="{Binding Rank, Source={x:Static helpers:FieldLabelsSource.Instance}}" Style="{StaticResource FieldLabel}" />
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="50" Margin="0,0,0,14">
                            <DockPanel Margin="14,0,10,0">
                                <Grid>
                                    <TextBox Text="{Binding Rank, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Background="Transparent" BorderThickness="0" FontSize="16" Height="46" Padding="0" VerticalContentAlignment="Center" />
                                </Grid>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="{Binding Roll, Source={x:Static helpers:FieldLabelsSource.Instance}}" Style="{StaticResource FieldLabel}" />
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="50" Margin="0,0,0,14">
                            <DockPanel Margin="14,0,10,0">
                                <Grid>
                                    <TextBox Text="{Binding RollRegNo, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Background="Transparent" BorderThickness="0" FontSize="16" Height="46" Padding="0" VerticalContentAlignment="Center" />
                                </Grid>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="{Binding Phone, Source={x:Static helpers:FieldLabelsSource.Instance}}" Style="{StaticResource FieldLabel}" />
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="50" Margin="0,0,0,14">
                            <DockPanel Margin="14,0,10,0">
                                <Grid>
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"  Background="Transparent" BorderThickness="0" FontSize="16" Height="46" Padding="0" VerticalContentAlignment="Center" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Clubs -->
                    <StackPanel Visibility="{Binding IsClubs, Converter={StaticResource B2V}}">
                        <TextBlock Text="Select one or both clubs." Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource ClubCheck}" Content="AI Center" Tag="AI" Background="#7C3AED" IsChecked="{Binding JoinAi}" />
                        <CheckBox Style="{StaticResource ClubCheck}" Content="Fleet UMS Hobby Club" Tag="UMS" Background="#F59E0B" IsChecked="{Binding JoinHobbies}" />
                    </StackPanel>

                    <!-- PIN -->
                    <StackPanel Visibility="{Binding IsPin, Converter={StaticResource B2V}}" HorizontalAlignment="Center">
                        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="12" Height="64" Width="348" Margin="0,0,0,16">
                            <TextBlock Text="{Binding Display}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Keys}" Width="348">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" FontSize="26" Height="68" Margin="5"
                                            Command="{Binding DataContext.KeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Face / fingerprints -->
                    <StackPanel Visibility="{Binding IsBiometric, Converter={StaticResource B2V}}" HorizontalAlignment="Center">
                        <Border Width="150" Height="150" CornerRadius="75" Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="3" HorizontalAlignment="Center" Margin="0,4,0,18"><Viewbox Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path>
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource BigIcon}">
                                            <Setter Property="Data" Value="M12,11 V14 A8,8 0 0 1 11,18 M8.5,7.5 A5,5 0 0 1 17,11 V13 M9,12 V13 A12,12 0 0 1 7.5,19 M15,14 A15,15 0 0 1 14.2,19 M4.5,15 A10,10 0 0 0 5,12 V11 A7,7 0 0 1 17,6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Step}" Value="5">
                                                    <Setter Property="Data" Value="M4,8 V6 A2,2 0 0 1 6,4 H8 M16,4 H18 A2,2 0 0 1 20,6 V8 M20,16 V18 A2,2 0 0 1 18,20 H16 M8,20 H6 A2,2 0 0 1 4,18 V16 M15,10 A3,3 0 1 1 9,10 A3,3 0 1 1 15,10 M7.5,17 A5,5 0 0 1 16.5,17" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Canvas>
                        </Viewbox></Border>
                        <TextBlock FontSize="16" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Place the finger on the scanner, then press Scan." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Step}" Value="5">
                                            <Setter Property="Text" Value="Look straight at the camera, then press Scan face." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="{Binding ScanLabel}" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}"
                                FontSize="20" Height="56" Padding="36,0" HorizontalAlignment="Center" />
                        <Button Content="Skip for now" Command="{Binding SkipFaceCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextBrush}" FontSize="15" Padding="12,6" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="{Binding IsFaceStep, Converter={StaticResource B2V}}" />
                        <Button Content="Skip for now" Command="{Binding SkipFingersCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextBrush}" FontSize="15" Padding="12,6" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="{Binding IsFingerStep, Converter={StaticResource B2V}}" />
                    </StackPanel>

                    <!-- Saved -->
                    <StackPanel Visibility="{Binding IsSaved, Converter={StaticResource B2V}}" HorizontalAlignment="Center">
                        <Border Width="88" Height="88" CornerRadius="44" Background="{StaticResource SuccessSoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Data="M7,12 L10.5,15.5 L17,9" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="24" Height="24" Stretch="None" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.RenderTransform><ScaleTransform ScaleX="2.2" ScaleY="2.2" /></Path.RenderTransform>
                            </Path>
                        </Border>
                        <TextBlock Text="Registration successful" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding SavedText}" TextWrapping="Wrap" FontSize="18" TextAlignment="Center" Foreground="{StaticResource TextBrush}" />
                        <Button Content="Done" Command="{Binding BackCommand}" Style="{StaticResource PrimaryButton}"
                                FontSize="18" Height="52" Width="180" HorizontalAlignment="Center" Margin="0,22,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding Message}" helpers:AutoHide.Seconds="6" FontSize="16" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,14,0,0" />

                    <Button Content="Next  →" Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}"
                            FontSize="17" Height="52" Width="160" HorizontalAlignment="Right" Margin="0,18,0,0"
                            Visibility="{Binding ShowNext, Converter={StaticResource B2V}}" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>














