<UserControl xmlns:helpers="clr-namespace:HobbiesClub.App.Helpers" x:Class="HobbiesClub.App.Views.RegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </UserControl.Resources>
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center">
            <StackPanel Width="420" Margin="0,40,0,20">
                <TextBlock Text="{Binding Prompt}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,0,0,14" />

                <StackPanel Visibility="{Binding IsDetails, Converter={StaticResource B2V}}">
                    <TextBlock Text="Name" FontSize="16" />
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Margin="0,4,0,10" />
                    <TextBlock Text="Phone" FontSize="16" />
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Margin="0,4,0,10" />
                    <TextBlock Text="Rank" FontSize="16" />
                    <TextBox Text="{Binding Rank, UpdateSourceTrigger=PropertyChanged}" FontSize="20" MaxLength="50" Margin="0,4,0,10" />
                    <TextBlock Text="R/N (Roll / Regiment No.)" FontSize="16" />
                    <TextBox Text="{Binding RollRegNo, UpdateSourceTrigger=PropertyChanged}" FontSize="20" MaxLength="50" Margin="0,4,0,10" />
                    <TextBlock Text="Unit" FontSize="16" />
                    <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" FontSize="20" MaxLength="50" Margin="0,4,0,10" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsClubs, Converter={StaticResource B2V}}">
                    <CheckBox Content="AI Club" IsChecked="{Binding JoinAi}" FontSize="24" Margin="0,6" />
                    <CheckBox Content="Hobbies Club" IsChecked="{Binding JoinHobbies}" FontSize="24" Margin="0,6" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsPin, Converter={StaticResource B2V}}">
                    <Border BorderBrush="Gray" BorderThickness="1" Height="56" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Display}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Keys}" Width="330">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" FontSize="24" Height="60" Margin="4"
                                        Command="{Binding DataContext.KeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding IsBiometric, Converter={StaticResource B2V}}">
                    <TextBlock TextWrapping="Wrap" FontSize="16" Foreground="Gray" HorizontalAlignment="Center"
                               Text="Look at the camera, then press Scan face." Margin="0,0,0,12" />
                    <Button Content="{Binding ScanLabel}" Command="{Binding ScanCommand}"
                            FontSize="24" Padding="20,14" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsSaved, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding SavedText}" TextWrapping="Wrap" FontSize="20" Foreground="SeaGreen" />
                    <Button Content="Done" Command="{Binding BackCommand}" FontSize="22" Padding="20,10"
                            HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>

                <TextBlock Text="{Binding Message}" helpers:AutoHide.Seconds="6" FontSize="18" Foreground="Firebrick" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                <Button Content="Next" Command="{Binding NextCommand}" FontSize="20" Padding="16,8" Margin="0,12,0,0"
                        HorizontalAlignment="Center" Visibility="{Binding ShowNext, Converter={StaticResource B2V}}" />
            </StackPanel>
        </ScrollViewer>
        <Button Content="Cancel" Command="{Binding BackCommand}" Padding="12,6"
                HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Grid>
</UserControl>


