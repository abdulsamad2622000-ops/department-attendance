<UserControl x:Class="HobbiesClub.App.Views.RegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HobbiesClub.App.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <helpers:StepStateConverter x:Key="StepState" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="BigIcon" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{StaticResource PrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Button Content="Cancel" Command="{Binding BackCommand}" Height="44" Padding="18,0" HorizontalAlignment="Left" />
            <TextBlock Text="New member registration" FontSize="16" Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Progress -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,24">
            <StackPanel.Resources>
                <Style TargetType="StackPanel">
                    <Setter Property="Orientation" Value="Horizontal" />
                    <Setter Property="Margin" Value="14,0" />
                </Style>
            </StackPanel.Resources>
            <StackPanel>
                <Border Width="30" Height="30" CornerRadius="15" Background="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=1-1|fill}">
                    <TextBlock Text="1" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=1-1|fg}" />
                </Border>
                <TextBlock Text="Details" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=1-1|label}" FontWeight="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=1-1|weight}" />
            </StackPanel>
            <StackPanel>
                <Border Width="30" Height="30" CornerRadius="15" Background="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=2-2|fill}">
                    <TextBlock Text="2" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=2-2|fg}" />
                </Border>
                <TextBlock Text="Clubs" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=2-2|label}" FontWeight="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=2-2|weight}" />
            </StackPanel>
            <StackPanel>
                <Border Width="30" Height="30" CornerRadius="15" Background="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=3-4|fill}">
                    <TextBlock Text="3" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=3-4|fg}" />
                </Border>
                <TextBlock Text="PIN" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=3-4|label}" FontWeight="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=3-4|weight}" />
            </StackPanel>
            <StackPanel>
                <Border Width="30" Height="30" CornerRadius="15" Background="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=5-5|fill}">
                    <TextBlock Text="4" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=5-5|fg}" />
                </Border>
                <TextBlock Text="Face" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=5-5|label}" FontWeight="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=5-5|weight}" />
            </StackPanel>
            <StackPanel>
                <Border Width="30" Height="30" CornerRadius="15" Background="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=6-7|fill}">
                    <TextBlock Text="5" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=6-7|fg}" />
                </Border>
                <TextBlock Text="Fingerprints" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=6-7|label}" FontWeight="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=6-7|weight}" />
            </StackPanel>
            <StackPanel>
                <Border Width="30" Height="30" CornerRadius="15" Background="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=8-8|fill}">
                    <TextBlock Text="6" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=8-8|fg}" />
                </Border>
                <TextBlock Text="Done" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=8-8|label}" FontWeight="{Binding Step, Converter={StaticResource StepState}, ConverterParameter=8-8|weight}" />
            </StackPanel>
        </StackPanel>

        <!-- Card -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}" Width="640" Padding="32" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding Prompt}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,20" />

                    <!-- Details -->
                    <StackPanel Visibility="{Binding IsDetails, Converter={StaticResource B2V}}">
                        <TextBlock Text="Full name" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                        <TextBlock Text="Phone" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rank" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Rank, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Style="{StaticResource Field}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="R/N (Roll / Regiment No.)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RollRegNo, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Style="{StaticResource Field}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Unit" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Style="{StaticResource Field}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Clubs -->
                    <StackPanel Visibility="{Binding IsClubs, Converter={StaticResource B2V}}">
                        <TextBlock Text="Select one or both clubs." Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,14" />
                        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12">
                            <CheckBox Content="AI Club" IsChecked="{Binding JoinAi}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <CheckBox Content="Hobbies Club" IsChecked="{Binding JoinHobbies}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- PIN -->
                    <StackPanel Visibility="{Binding IsPin, Converter={StaticResource B2V}}" HorizontalAlignment="Center">
                        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="12" Height="64" Width="348" Margin="0,0,0,16">
                            <TextBlock Text="{Binding Display}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Keys}" Width="348">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" FontSize="26" Height="68" Margin="5"
                                            Command="{Binding DataContext.KeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Face / fingerprints -->
                    <StackPanel Visibility="{Binding IsBiometric, Converter={StaticResource B2V}}" HorizontalAlignment="Center">
                        <Viewbox Width="96" Height="96" HorizontalAlignment="Center" Margin="0,4,0,12">
                            <Canvas Width="24" Height="24">
                                <Path>
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource BigIcon}">
                                            <Setter Property="Data" Value="M12,11 V14 A8,8 0 0 1 11,18 M8.5,7.5 A5,5 0 0 1 17,11 V13 M9,12 V13 A12,12 0 0 1 7.5,19 M15,14 A15,15 0 0 1 14.2,19 M4.5,15 A10,10 0 0 0 5,12 V11 A7,7 0 0 1 17,6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Step}" Value="5">
                                                    <Setter Property="Data" Value="M4,8 V6 A2,2 0 0 1 6,4 H8 M16,4 H18 A2,2 0 0 1 20,6 V8 M20,16 V18 A2,2 0 0 1 18,20 H16 M8,20 H6 A2,2 0 0 1 4,18 V16 M15,10 A3,3 0 1 1 9,10 A3,3 0 1 1 15,10 M7.5,17 A5,5 0 0 1 16.5,17" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Canvas>
                        </Viewbox>
                        <TextBlock FontSize="16" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Place the finger on the scanner, then press Scan." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Step}" Value="5">
                                            <Setter Property="Text" Value="Look straight at the camera, then press Scan face." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="{Binding ScanLabel}" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}"
                                FontSize="20" Height="56" Padding="36,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Saved -->
                    <StackPanel Visibility="{Binding IsSaved, Converter={StaticResource B2V}}" HorizontalAlignment="Center">
                        <Border Width="88" Height="88" CornerRadius="44" Background="{StaticResource SuccessSoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Data="M7,12 L10.5,15.5 L17,9" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="24" Height="24" Stretch="None" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.RenderTransform><ScaleTransform ScaleX="2.2" ScaleY="2.2" /></Path.RenderTransform>
                            </Path>
                        </Border>
                        <TextBlock Text="{Binding SavedText}" TextWrapping="Wrap" FontSize="18" TextAlignment="Center" Foreground="{StaticResource TextBrush}" />
                        <Button Content="Done" Command="{Binding BackCommand}" Style="{StaticResource PrimaryButton}"
                                FontSize="18" Height="52" Width="180" HorizontalAlignment="Center" Margin="0,22,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding Message}" helpers:AutoHide.Seconds="6" FontSize="16" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,14,0,0" />

                    <Button Content="Next" Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}"
                            FontSize="17" Height="52" Width="160" HorizontalAlignment="Right" Margin="0,18,0,0"
                            Visibility="{Binding ShowNext, Converter={StaticResource B2V}}" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
