<Application x:Class="HobbiesClub.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HobbiesClub.App.ViewModels"
             xmlns:views="clr-namespace:HobbiesClub.App.Views">
    <Application.Resources>
        <DataTemplate DataType="{x:Type vm:SetupViewModel}">
            <views:SetupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChangePasswordViewModel}">
            <views:ChangePasswordView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminShellViewModel}">
            <views:AdminShellView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KioskViewModel}">
            <views:KioskView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PinViewModel}">
            <views:PinView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegistrationViewModel}">
            <views:RegistrationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemberClubsViewModel}">
            <views:MemberClubsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClubDetailViewModel}">
            <views:ClubDetailView />
        </DataTemplate>
    </Application.Resources>
</Application>



